---
import type { Lang } from '../../data/yi-ai';
import ContactPanel from './ContactPanel.astro';
import { zh } from '../../data/zh';
import { en } from '../../data/en';
interface Props {
  lang: Lang;
  /** The home page's contact chapter; other pages use the resident contact button (round 40). */
  inline?: boolean;
}
const { lang, inline = false } = Astro.props;
const t = lang === 'zh' ? zh : en;
const zhUI = lang === 'zh';
---

{/* The home page's contact chapter with the brand promise (rounds 38 and 40). */}
{
  inline ? (
    <section id="inquiry" class="cta-band cta-inline">
      <div class="cta-bg" aria-hidden="true">
        <span class="hero-grid-lines" />
      </div>
      <div class="container cta-layout">
        <div class="cta-copy" data-reveal>
          <h2 class="cta-title">{t.ctaTitle}</h2>
          <p class="footer-promise cta-promise">
            {zhUI ? (
              <>
                让 AI <em>易懂</em>、<em>易用</em>、<em>易落地</em>。
              </>
            ) : (
              <>
                Make AI <em>easy</em> to understand, use and put to work.
              </>
            )}
          </p>
          <p class="cta-body">{t.ctaBody}</p>
        </div>
        <div data-reveal>
          <ContactPanel lang={lang} compact />
        </div>
      </div>
    </section>
  ) : null
}
