---
import { home } from '../../data/home';
import type { Lang } from '../../data/yi-ai';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = home[lang];

// Round 89: the owner picked option #2 "solid blocks" from the matrix comparison board and asked for it denser. A 9x9
// field of square prisms (lit left face, darker right face, bright top) on an isometric floor, spaced so they do not
// overlap, tallest in the middle; they rise and fall in a ripple from the centre. The three layer names sit in a row
// underneath, never over the art. Pure CSS; reduced motion leaves the field still.
const cx = 310;
const cy = 360;
const step = 32; // x spacing per index; y is half of it (isometric)
const a = 11; // block footprint half-width
const b = a / 2; // block footprint half-height
const n = 4; // indices -4..4
const range = Array.from({ length: n * 2 + 1 }, (_, k) => k - n);
const maxR = Math.hypot(n, n) * 1.06;
const blocks = range
  .flatMap((i) =>
    range.map((j) => {
      const r = Math.hypot(i, j);
      const height = Math.round(40 + Math.max(0, 1 - r / maxR) ** 1.1 * 160);
      const x = cx + (i - j) * step;
      const y = cy + (i + j) * (step / 2);
      const top = y - height;
      return {
        y,
        height,
        delay: -(r * 0.32).toFixed(2),
        opacity: (0.45 + 0.55 * (1 - r / maxR)).toFixed(2),
        left: `${x - a},${top} ${x},${top + b} ${x},${y + b} ${x - a},${y}`,
        right: `${x},${top + b} ${x + a},${top} ${x + a},${y} ${x},${y + b}`,
        cap: `${x},${top - b} ${x + a},${top} ${x},${top + b} ${x - a},${top}`,
      };
    })
  )
  .sort((p, q) => p.y - q.y);
const edge = (n + 0.75) * step;
const floor = `${cx},${cy - edge / 2} ${cx + edge},${cy} ${cx},${cy + edge / 2} ${cx - edge},${cy}`;
const layers = [
  { key: 'workbuddy', ...h.layers.workbuddy },
  { key: 'model-services', ...h.layers['model-services'] },
  { key: 'infrastructure', ...h.layers.infrastructure },
] as const;
---

<div class="hero-matrix">
  <svg class="matrix" viewBox="0 130 620 400" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="matrix-left" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#bcd3ff"></stop>
        <stop offset="0.4" stop-color="#4f86f2" stop-opacity="0.9"></stop>
        <stop offset="1" stop-color="#1d3f9e" stop-opacity="0.1"></stop>
      </linearGradient>
      <linearGradient id="matrix-right" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#5f8ff0"></stop>
        <stop offset="0.45" stop-color="#1f3f9a" stop-opacity="0.85"></stop>
        <stop offset="1" stop-color="#0f2260" stop-opacity="0.05"></stop>
      </linearGradient>
      <radialGradient id="matrix-glow">
        <stop offset="0" stop-color="#2f6bff" stop-opacity="0.5"></stop>
        <stop offset="1" stop-color="#2f6bff" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <ellipse cx={cx} cy={cy} rx="310" ry="165" fill="url(#matrix-glow)"></ellipse>
    <polygon class="matrix-floor" points={floor}></polygon>
    {
      blocks.map(({ height, delay, opacity, left, right, cap }) => (
        <g class="matrix-block" style={`--d:${delay}s;--h:${height}`} opacity={opacity}>
          <g class="matrix-shaft">
            <polygon points={left} fill="url(#matrix-left)" />
            <polygon points={right} fill="url(#matrix-right)" />
          </g>
          <polygon class="matrix-cap" points={cap} />
        </g>
      ))
    }
  </svg>
  <ul class="matrix-layers">
    {
      layers.map((layer) => (
        <li data-layer={layer.key}>
          <strong>{layer.name}</strong>
          <span>{layer.tag}</span>
        </li>
      ))
    }
  </ul>
</div>
