---
import { home } from '../../data/home';
import type { Lang } from '../../data/yi-ai';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = home[lang];

// Round 88 (owner's call, "keep it simple"): the compute field exactly as on the round 83 comparison board, option E —
// a 9x9 field of light columns on an isometric floor, tallest in the middle, rising and falling in a wave from the
// centre. Rounds 86–87 added density, prisms and coloured beacons; those are gone. The three layer names sit in a
// row underneath, never over the art. Pure CSS; reduced motion leaves the field still.
const ox = 300;
const oy = 330;
const range = [-4, -3, -2, -1, 0, 1, 2, 3, 4];
const columns = range
  .flatMap((i) =>
    range.map((j) => ({
      x: ox + (i - j) * 30,
      y: oy + (i + j) * 15,
      height: 60 + (4 - Math.abs(i)) * 14 + (4 - Math.abs(j)) * 14,
      delay: -(Math.abs(i) + Math.abs(j)) * 0.25,
      opacity: (0.35 + 0.65 * (1 - (Math.abs(i) + Math.abs(j)) / 8)).toFixed(2),
    }))
  )
  .sort((a, b) => a.y - b.y);
const layers = [
  { key: 'workbuddy', ...h.layers.workbuddy },
  { key: 'model-services', ...h.layers['model-services'] },
  { key: 'infrastructure', ...h.layers.infrastructure },
] as const;
---

<div class="hero-matrix">
  <svg class="matrix" viewBox="0 120 600 370" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="matrix-column" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e3ebff"></stop>
        <stop offset="0.25" stop-color="#7fa6ff"></stop>
        <stop offset="1" stop-color="#2f6bff" stop-opacity="0.15"></stop>
      </linearGradient>
      <radialGradient id="matrix-glow">
        <stop offset="0" stop-color="#2f6bff" stop-opacity="0.45"></stop>
        <stop offset="1" stop-color="#2f6bff" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <ellipse cx="300" cy="330" rx="290" ry="150" fill="url(#matrix-glow)"></ellipse>
    <polygon class="matrix-floor" points="300,195 570,330 300,465 30,330"></polygon>
    <polygon class="matrix-floor matrix-floor-inner" points="300,225 510,330 300,435 90,330"></polygon>
    {
      columns.map(({ x, y, height, delay, opacity }) => (
        <rect
          class="matrix-column"
          x={x - 5}
          y={y - height}
          width="10"
          height={height}
          rx="2"
          fill="url(#matrix-column)"
          opacity={opacity}
          style={`--d:${delay}s`}
        />
      ))
    }
  </svg>
  <ul class="matrix-layers">
    {
      layers.map((layer) => (
        <li data-layer={layer.key}>
          <strong>{layer.name}</strong>
          <span>{layer.tag}</span>
        </li>
      ))
    }
  </ul>
</div>
