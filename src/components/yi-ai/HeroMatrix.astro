---
import { home } from '../../data/home';
import type { Lang } from '../../data/yi-ai';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = home[lang];

// Round 86: the home hero shows one scene, the compute field the owner chose from the comparison board (round 84's
// three rotating scenes were withdrawn). An 11x11 field of light columns on an isometric floor; a ripple runs out
// from the centre and the middle glows. The three layer names sit in a row underneath, never over the art. Pure CSS;
// reduced motion leaves the field still.
// Round 87: each column is a square prism (lit left face, darker right face, bright top), and three beacon columns
// take the business colours — applications left, models in the middle, compute right, the order of the names
// below — each with a beam of light over its top.
const prism = { a: 6, b: 3 }; // footprint half-width and half-height (isometric)
const beacons: Record<string, 'green' | 'violet' | 'sky'> = { '-1,2': 'green', '0,0': 'violet', '2,-1': 'sky' };
const palettes = {
  base: ['#c3d8ff', '#4b84f2', '#1d3f9e'],
  green: ['#d2fff2', '#25c79c', '#0b5a48'],
  violet: ['#ece5ff', '#9277ff', '#3b2a8f'],
  sky: ['#e3f6ff', '#45b6ff', '#0b5584'],
} as const;
const cx = 320;
const cy = 300;
const step = 24; // half the column spacing along x; y is half of it (isometric)
const n = 5; // indices -5..5
const range = Array.from({ length: n * 2 + 1 }, (_, k) => k - n);
const maxR = Math.hypot(n, n);
const columns = range
  .flatMap((i) =>
    range.map((j) => {
      const r = Math.hypot(i, j);
      const height = Math.round(44 + Math.max(0, 1 - r / maxR) ** 1.2 * 190);
      const beacon = beacons[`${i},${j}`];
      return {
        x: cx + (i - j) * step,
        y: cy + (i + j) * (step / 2),
        height,
        delay: -(r * 0.3).toFixed(2),
        // Columns fade towards the edge of the field so it melts into the night background.
        opacity: beacon ? '1' : (0.22 + 0.78 * (1 - r / maxR) ** 0.9).toFixed(2),
        palette: beacon ?? 'base',
        beacon: Boolean(beacon),
      };
    })
  )
  .sort((a, b) => a.y - b.y || a.x - b.x);
// Floor rhombus and grid lines along both isometric axes.
const corner = (i: number, j: number) => [cx + (i - j) * step, cy + (i + j) * (step / 2)];
const floor = [
  corner(-n - 0.75, -n - 0.75),
  corner(n + 0.75, -n - 0.75),
  corner(n + 0.75, n + 0.75),
  corner(-n - 0.75, n + 0.75),
]
  .map(([x, y]) => `${x},${y}`)
  .join(' ');
const gridLines = range.flatMap((k) => [
  [corner(k, -n - 0.75), corner(k, n + 0.75)],
  [corner(-n - 0.75, k), corner(n + 0.75, k)],
]);
const layers = [
  { key: 'workbuddy', ...h.layers.workbuddy },
  { key: 'model-services', ...h.layers['model-services'] },
  { key: 'infrastructure', ...h.layers.infrastructure },
] as const;
---

<div class="hero-matrix">
  <svg class="matrix" viewBox="0 0 640 460" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="matrix-column" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f2f7ff"></stop>
        <stop offset="0.12" stop-color="#9cc2ff"></stop>
        <stop offset="0.55" stop-color="#3f7cf0" stop-opacity="0.75"></stop>
        <stop offset="1" stop-color="#2050c8" stop-opacity="0.08"></stop>
      </linearGradient>
      <radialGradient id="matrix-glow">
        <stop offset="0" stop-color="#3d7bff" stop-opacity="0.5"></stop>
        <stop offset="0.55" stop-color="#2a5fe0" stop-opacity="0.16"></stop>
        <stop offset="1" stop-color="#2a5fe0" stop-opacity="0"></stop>
      </radialGradient>
      {
        Object.entries(palettes).map(([name, [light, mid, deep]]) => (
          <>
            <linearGradient id={`matrix-left-${name}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color={light} />
              <stop offset="0.35" stop-color={mid} stop-opacity="0.9" />
              <stop offset="1" stop-color={deep} stop-opacity="0.08" />
            </linearGradient>
            <linearGradient id={`matrix-right-${name}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color={mid} />
              <stop offset="0.4" stop-color={deep} stop-opacity="0.85" />
              <stop offset="1" stop-color={deep} stop-opacity="0.05" />
            </linearGradient>
            <linearGradient id={`matrix-beam-${name}`} x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color={light} stop-opacity="0.85" />
              <stop offset="1" stop-color={mid} stop-opacity="0" />
            </linearGradient>
          </>
        ))
      }
      <radialGradient id="matrix-pool">
        <stop offset="0" stop-color="#8fb4ff" stop-opacity="0.35"></stop>
        <stop offset="1" stop-color="#8fb4ff" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="matrix-halo">
        <stop offset="0" stop-color="#9cc2ff" stop-opacity="0.32"></stop>
        <stop offset="1" stop-color="#9cc2ff" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <ellipse cx={cx} cy={cy} rx="320" ry="175" fill="url(#matrix-glow)"></ellipse>
    <ellipse class="matrix-halo" cx={cx} cy={cy - 120} rx="150" ry="150" fill="url(#matrix-halo)"></ellipse>
    <polygon class="matrix-floor" points={floor}></polygon>
    <ellipse class="matrix-pool" cx={cx} cy={cy} rx="170" ry="85" fill="url(#matrix-pool)"></ellipse>
    <g class="matrix-grid">
      {gridLines.map(([[x1, y1], [x2, y2]]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
    </g>
    {
      columns.map(({ x, y, height, delay, opacity, palette, beacon }) => {
        const { a, b } = prism;
        const top = y - height;
        return (
          <g class="matrix-column" data-palette={palette} style={`--d:${delay}s;--h:${height}`} opacity={opacity}>
            <ellipse class="matrix-foot" cx={x} cy={y + b} rx={a + 3} ry={b + 1.5} />
            <g class="matrix-shaft">
              <polygon
                points={`${x - a},${top} ${x},${top + b} ${x},${y + b} ${x - a},${y}`}
                fill={`url(#matrix-left-${palette})`}
              />
              <polygon
                points={`${x},${top + b} ${x + a},${top} ${x + a},${y} ${x},${y + b}`}
                fill={`url(#matrix-right-${palette})`}
              />
            </g>
            <g class="matrix-top">
              {beacon && (
                <rect
                  class="matrix-beam"
                  x={x - 2.5}
                  y={top - 100}
                  width="5"
                  height="100"
                  rx="2.5"
                  fill={`url(#matrix-beam-${palette})`}
                />
              )}
              <polygon class="matrix-cap" points={`${x},${top - b} ${x + a},${top} ${x},${top + b} ${x - a},${top}`} />
            </g>
          </g>
        );
      })
    }
  </svg>
  <ul class="matrix-layers">
    {
      layers.map((layer) => (
        <li data-layer={layer.key}>
          <strong>{layer.name}</strong>
          <span>{layer.tag}</span>
        </li>
      ))
    }
  </ul>
</div>
