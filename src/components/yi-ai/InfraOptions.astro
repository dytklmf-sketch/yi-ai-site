---
import { ArrowRight } from '@lucide/astro';
import { infraOptions } from '../../data/infra-detail';
import { inquiryPath, type Lang } from '../../data/yi-ai';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const x = infraOptions[lang];
const zhUI = lang === 'zh';
---

{
  /* Round 53: three ways to get compute side by side; the middle card is what Easy AI offers — first-hand data-center
    resources — lifted and outlined in the page blue. Same light and sheen as the other service cards. */
}
<section id="options" class="section" aria-labelledby="options-title">
  <div class="container">
    <h2 id="options-title" class="section-title" data-reveal>{x.title}</h2>
    <ul class="io-options" data-reveal>
      {
        x.options.map((option, i) => (
          <li class:list={['io-option', 'glow-card', { 'io-ours': option.ours }]} style={`--i:${i}`} data-glow>
            <span class="card-sheen" aria-hidden="true" />
            <header class="io-head">
              <h3>{option.name}</h3>
              {option.ours && <span class="io-badge">{x.badge}</span>}
              <p>{option.who}</p>
            </header>
            <dl class="io-rows">
              {option.rows.map(([term, text]) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{text}</dd>
                </div>
              ))}
            </dl>
            {option.ours && (
              <a class="text-link" href={inquiryPath(lang, 'infrastructure')}>
                {zhUI ? '咨询机房资源' : 'Ask about resources'}
                <ArrowRight size={16} />
              </a>
            )}
          </li>
        ))
      }
    </ul>
    <p class="io-note" data-reveal>{x.note}</p>
  </div>
</section>
