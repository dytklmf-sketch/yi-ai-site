---
import { infraOptions } from '../../data/infra-detail';
import type { Lang } from '../../data/yi-ai';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const x = infraOptions[lang];
---

{
  /* Round 53: three ways to get compute side by side, with the same light as the other service cards. Round 78: the
    data-center option is no longer badged or highlighted; the three read as equals. */
}
<section id="options" class="section" aria-labelledby="options-title">
  <div class="container">
    <h2 id="options-title" class="section-title" data-reveal>{x.title}</h2>
    <ul class="io-options" data-reveal>
      {
        x.options.map((option, i) => (
          <li class="io-option glow-card" style={`--i:${i}`} data-glow>
            <header class="io-head">
              <h3>{option.name}</h3>
              <p>{option.who}</p>
            </header>
            <dl class="io-rows">
              {option.rows.map(([term, text]) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{text}</dd>
                </div>
              ))}
            </dl>
          </li>
        ))
      }
    </ul>
    <p class="io-note" data-reveal>{x.note}</p>
  </div>
</section>
