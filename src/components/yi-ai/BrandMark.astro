---
import { brandName, pathFor, type Lang } from '../../data/yi-ai';
interface Props {
  lang: Lang;
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
---

<a
  class:list={['brand-mark', { compact }]}
  href={pathFor(lang)}
  aria-label={lang === 'zh' ? '易AI 首页' : `${brandName(lang)} home`}
>
  <img src={`/brand/logo-${lang}.svg`} alt={brandName(lang)} width={lang === 'zh' ? 220.47 : 302.59} height="72" />
</a>
