---
import { home } from '../../data/home';
import { services, type Lang, type Service } from '../../data/yi-ai';

interface Props {
  lang: Lang;
  id: string;
  active?: Service;
  labels?: boolean;
  class?: string;
}
const { lang, id, active, labels = true, class: className } = Astro.props;
const h = home[lang];

// Isometric slab geometry. Each slab's artwork is drawn on a flat 100x100 square
// and projected with matrix(2 1 -2 1 cx top), so every layer shares one grid.
// Round 82: the labelled stack sits in the middle of an 860-wide canvas with each layer's name on the left and its
// tag on the right, so the drawing is mirror-balanced; the unlabelled one keeps its narrow canvas around x = 250.
// Round 83: the labelled (hero) stack also stands on a lit stage of perspective rings, with a column of light
// through the layers; the canvas grows to 680 tall for the stage.
const cx = labels ? 430 : 250;
const stageY = 600;
// Round 91: the label rows pull a third of the way towards the middle layer, where the hero orbit (now centred on
// the stack) is widest, so no text runs over the ring or its ticks.
const labelY = (cy: number) => Math.round(275 + (cy - 275) * 0.66);
const stageRings = [
  { rx: 380, ry: 120, cls: 'stage-ring stage-ring-outer' },
  { rx: 300, ry: 95, cls: 'stage-ring' },
  { rx: 215, ry: 68, cls: 'stage-ring stage-ring-inner' },
];
const w = 190;
const half = 95;
const depth = 18;
const centers: Record<Service, number> = { workbuddy: 125, 'model-services': 275, infrastructure: 425 };
const top = (cy: number) => `${cx},${cy - half} ${cx + w},${cy} ${cx},${cy + half} ${cx - w},${cy}`;
const left = (cy: number) => `${cx - w},${cy} ${cx},${cy + half} ${cx},${cy + half + depth} ${cx - w},${cy + depth}`;
const right = (cy: number) => `${cx},${cy + half} ${cx + w},${cy} ${cx + w},${cy + depth} ${cx},${cy + half + depth}`;
const project = (cy: number) => `matrix(${w / 100} ${half / 100} ${-w / 100} ${half / 100} ${cx} ${cy - half})`;
const nodes = [
  [18, 22],
  [50, 14],
  [82, 26],
  [30, 52],
  [66, 48],
  [20, 82],
  [52, 80],
  [84, 74],
];
const edges = [
  [0, 1],
  [1, 2],
  [0, 3],
  [1, 3],
  [1, 4],
  [2, 4],
  [3, 4],
  [3, 5],
  [3, 6],
  [4, 6],
  [4, 7],
  [6, 7],
  [5, 6],
];
const drawOrder = [...services].reverse();
---

<svg
  class:list={['stack', 'stack-dark', { 'stack-labelled': labels }, className]}
  viewBox={labels ? '0 0 860 680' : '40 0 420 570'}
  data-stack
  data-active={active}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${id}-top`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="stop-top-a"></stop>
      <stop offset="1" class="stop-top-b"></stop>
    </linearGradient>
    <linearGradient id={`${id}-beam`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7ea2f5" stop-opacity="0"></stop>
      <stop offset="0.5" stop-color="#9dbbff" stop-opacity="1"></stop>
      <stop offset="1" stop-color="#7ea2f5" stop-opacity="0"></stop>
    </linearGradient>
    <radialGradient id={`${id}-glow`}>
      <stop offset="0" stop-color="#4f82ff" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#4f82ff" stop-opacity="0"></stop>
    </radialGradient>
    {
      labels && (
        <>
          <radialGradient id={`${id}-pillar`}>
            <stop offset="0" stop-color="#9dbbff" stop-opacity="0.55" />
            <stop offset="0.45" stop-color="#4f82ff" stop-opacity="0.22" />
            <stop offset="1" stop-color="#4f82ff" stop-opacity="0" />
          </radialGradient>
          <radialGradient id={`${id}-stage`}>
            <stop offset="0" stop-color="#6f9bff" stop-opacity="0.5" />
            <stop offset="0.6" stop-color="#2f5fe0" stop-opacity="0.16" />
            <stop offset="1" stop-color="#2f5fe0" stop-opacity="0" />
          </radialGradient>
        </>
      )
    }
  </defs>

  {
    labels && (
      <g class="stack-stage">
        <ellipse class="stage-glow" cx={cx} cy={stageY} rx="400" ry="130" fill={`url(#${id}-stage)`} />
        {stageRings.map(({ rx, ry, cls }) => (
          <ellipse class={cls} cx={cx} cy={stageY} rx={rx} ry={ry} />
        ))}
        {[0, 90, 180, 270].map((angle) => {
          const a = (angle * Math.PI) / 180;
          return <circle class="stage-node" cx={cx + 380 * Math.cos(a)} cy={stageY + 120 * Math.sin(a)} r="3.5" />;
        })}
        <ellipse class="stage-pillar" cx={cx} cy="330" rx="120" ry="340" fill={`url(#${id}-pillar)`} />
      </g>
    )
  }

  <ellipse class="stack-halo" cx={cx} cy="300" rx={labels ? 260 : 210} ry="240" fill={`url(#${id}-glow)`}></ellipse>

  <g class="stack-guides">
    <line x1={cx - w} y1={centers.workbuddy + depth} x2={cx - w} y2={centers.infrastructure}></line>
    <line x1={cx + w} y1={centers.workbuddy + depth} x2={cx + w} y2={centers.infrastructure}></line>
    <line x1={cx} y1={centers.workbuddy + half + depth} x2={cx} y2={centers.infrastructure + half}></line>
  </g>

  <g class="stack-beam">
    <line class="beam-core" x1={cx} y1="20" x2={cx} y2="540"></line>
    <line class="beam-pulse" x1={cx} y1="20" x2={cx} y2="540" stroke={`url(#${id}-beam)`}></line>
  </g>

  {
    drawOrder.map((service) => {
      const cy = centers[service];
      return (
        <g class="slab" data-layer={service} style={`--i:${services.indexOf(service)}`}>
          <polygon class="slab-left" points={left(cy)} />
          <polygon class="slab-right" points={right(cy)} />
          <polygon class="slab-top" points={top(cy)} fill={`url(#${id}-top)`} />
          <g class="slab-art" transform={project(cy)}>
            {service === 'workbuddy' && (
              <>
                <rect x="10" y="10" width="36" height="26" rx="3" />
                <rect x="52" y="10" width="38" height="26" rx="3" class="art-accent" />
                <rect x="10" y="42" width="80" height="16" rx="3" />
                <rect x="10" y="64" width="24" height="26" rx="3" />
                <rect x="38" y="64" width="24" height="26" rx="3" />
                <rect x="66" y="64" width="24" height="26" rx="3" />
                <line x1="16" y1="18" x2="36" y2="18" />
                <line x1="16" y1="26" x2="30" y2="26" />
              </>
            )}
            {service === 'model-services' && (
              <>
                {edges.map(([a, b]) => (
                  <line x1={nodes[a][0]} y1={nodes[a][1]} x2={nodes[b][0]} y2={nodes[b][1]} />
                ))}
                {nodes.map(([x, y], i) => (
                  <circle cx={x} cy={y} r={i === 4 ? 5 : 3.2} class:list={{ 'art-accent': i === 4 }} />
                ))}
              </>
            )}
            {service === 'infrastructure' && (
              <>
                {[10, 24, 38, 52, 66, 80].map((y, i) => (
                  <>
                    <rect x="10" y={y} width="80" height="9" rx="2" />
                    <circle cx="16" cy={y + 4.5} r="1.6" class:list={{ 'art-accent': i % 2 === 0 }} />
                    <circle cx="21" cy={y + 4.5} r="1.6" />
                    <line x1="30" y1={y + 4.5} x2={62 + ((i * 7) % 20)} y2={y + 4.5} />
                  </>
                ))}
              </>
            )}
          </g>
          <ellipse class="slab-core" cx={cx} cy={cy} rx="16" ry="8" />
          {labels && (
            <g class="slab-label">
              <line x1={cx - w - 6} y1={cy} x2={cx - w - 20} y2={labelY(cy)} />
              <circle cx={cx - w - 22} cy={labelY(cy)} r="2.5" />
              <text x={cx - w - 30} y={labelY(cy) + 10} class="label-name" text-anchor="end">
                {h.layers[service].name}
              </text>
              <line x1={cx + w + 6} y1={cy} x2={cx + w + 20} y2={labelY(cy)} />
              <circle cx={cx + w + 22} cy={labelY(cy)} r="2.5" />
              <text x={cx + w + 30} y={labelY(cy) + 7} class="label-tag">
                {h.layers[service].tag}
              </text>
            </g>
          )}
        </g>
      );
    })
  }
</svg>
