---
import { ArrowRight, ArrowUpRight, Download } from '@lucide/astro';
import CostEstimator from './CostEstimator.astro';
import { getGuides } from '../../data/routes';
import { serviceExplainers } from '../../data/service-explainers';
import { articlePath, withBase, type Lang, type Service } from '../../data/yi-ai';

interface Props {
  lang: Lang;
  service: Service;
}
const { lang, service } = Astro.props;
const x = serviceExplainers[lang][service];
const zhUI = lang === 'zh';
const all = await getGuides(lang);
const guides = x.guides.map((key) => all.find((guide) => guide.data.pairKey === key)!);
// The same three changes the migration guide walks through, with the real CCG API base URL on this page.
const python = `import os
from openai import OpenAI

client = OpenAI(
    base_url="https://ccg-cli.online/v1",
    api_key=os.environ["CCG_API_KEY"],
)
resp = client.chat.completions.create(
    model="${zhUI ? '<模型名>' : '<model>'}",
    messages=[{"role": "user", "content": "${zhUI ? '你好' : 'Hello'}"}],
)
print(resp.choices[0].message.content, resp.usage)`;
---

<section id={x.id} class="section">
  <div class="container">
    <h2 class="section-title" data-reveal>{x.label}</h2>
    <div class="explainer" data-reveal>
      <div class="explainer-main">
        <p class="explainer-lead">{x.lead}</p>
        {
          service === 'model-services' && (
            <figure class="explainer-code">
              <figcaption class="micro-label">{zhUI ? 'Python 示例' : 'Python example'}</figcaption>
              <pre tabindex="0" set:text={python} />
            </figure>
          )
        }
        <table class="explainer-table">
          <caption>{x.table.caption}</caption>
          <thead>
            <tr>{x.table.head.map((cell) => <th scope="col">{cell}</th>)}</tr>
          </thead>
          <tbody>
            {
              x.table.rows.map(([first, ...rest]) => (
                <tr>
                  <th scope="row">{first}</th>
                  {rest.map((cell) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
        <ul class="explainer-facts">{x.facts.map((fact) => <li>{fact}</li>)}</ul>
        <p class="explainer-note">
          {x.note}
          {
            x.sources.map((source) => (
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.label}
                <ArrowUpRight size={13} />
                <span class="sr-only">{zhUI ? '（新窗口）' : '(new window)'}</span>
              </a>
            ))
          }
        </p>
      </div>
      <aside class="explainer-aside">
        {service === 'model-services' && <CostEstimator lang={lang} />}
        <div class="explainer-card">
          <p class="micro-label">{zhUI ? '下载' : 'Download'}</p>
          <ul>
            {
              x.downloads.map((item) => (
                <li>
                  <a class="text-link" href={withBase(`/templates/${lang}/${item.file}`)} download>
                    <Download size={16} />
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="explainer-card">
          <p class="micro-label">{zhUI ? '深入阅读' : 'Read more'}</p>
          <ul>
            {
              guides.map((guide) => (
                <li>
                  <a class="text-link" href={articlePath(lang, guide.data.pairKey)}>
                    {guide.data.title}
                    <ArrowRight size={16} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
