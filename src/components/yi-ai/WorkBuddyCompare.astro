---
import { Check, Minus } from '@lucide/astro';
import { workbuddyCompare } from '../../data/workbuddy-editions';
import { withBase, type Lang } from '../../data/yi-ai';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const x = workbuddyCompare[lang];
---

{
  /* Rounds 43–44: two product cards side by side, like an online shop's phone comparison; rows line up across them,
    hovering a row lights its pair, and the Enterprise card rises once with its checks popping in turn. */
}
<section id="compare" class="section wb-compare-section" aria-labelledby="compare-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="compare-title" class="section-title">{x.title}</h2>
      <p class="wb-compare-lead">{x.lead}</p>
    </div>
    <div class="wb-vs" data-reveal>
      <div class="wb-vs-card wb-vs-personal">
        <header class="wb-vs-head">
          <span class="wb-vs-brand">
            <img src={withBase('/partners/workbuddy.svg')} alt="" width="40" height="40" />
            <img
              class="wb-wordmark"
              src={withBase('/partners/workbuddy-wordmark.svg')}
              alt="WorkBuddy"
              width="74"
              height="32"
            />
          </span>
          <h3>{x.personal.name}</h3>
          <p>{x.personal.tiers}</p>
        </header>
        <ul role="list">
          {
            x.rows.map(([personal], i) => (
              <li data-row={i} style={`--i:${i}`}>
                <Minus size={16} />
                {personal}
              </li>
            ))
          }
        </ul>
      </div>
      <span class="wb-vs-divider" aria-hidden="true"><span>VS</span></span>
      <div class="wb-vs-card wb-vs-pro">
        <header class="wb-vs-head">
          <span class="wb-vs-brand">
            <img src={withBase('/partners/workbuddy.svg')} alt="" width="40" height="40" />
            <img
              class="wb-wordmark"
              src={withBase('/partners/workbuddy-wordmark.svg')}
              alt="WorkBuddy"
              width="74"
              height="32"
            />
          </span>
          <h3>
            {x.enterprise.name}
            {x.enterprise.price && <span class="wb-vs-price">{x.enterprise.price}</span>}
          </h3>
          <p>{x.enterprise.tiers}</p>
        </header>
        <ul role="list">
          {
            x.rows.map(([, enterprise], i) => (
              <li data-row={i} style={`--i:${i}`}>
                <Check size={16} />
                {enterprise}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="wb-compare-note">{x.note}</p>
  </div>
</section>
