---
import { workbuddyCompare } from '../../data/workbuddy-editions';
import type { Lang } from '../../data/yi-ai';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const x = workbuddyCompare[lang];
---

{/* Round 39: a spec-sheet comparison — the Enterprise column is set larger, like a phone's model comparison. */}
<section id="compare" class="section wb-compare-section" aria-labelledby="compare-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="compare-title" class="section-title">{x.title}</h2>
      <p class="wb-compare-lead">{x.lead}</p>
    </div>
    <div class="wb-compare" role="table" aria-labelledby="compare-title" data-reveal>
      <div class="wb-compare-row wb-compare-head" role="row">
        <span role="columnheader">{x.heads[0]}</span>
        <span role="columnheader">{x.heads[1]}</span>
        <span role="columnheader" class="wb-compare-pro">{x.heads[2]}</span>
      </div>
      {
        x.rows.map(([label, personal, enterprise]) => (
          <div class="wb-compare-row" role="row">
            <span role="rowheader">{label}</span>
            <span role="cell">{personal}</span>
            <span role="cell" class="wb-compare-pro">
              {enterprise}
            </span>
          </div>
        ))
      }
    </div>
    <p class="wb-compare-note">{x.note}</p>
  </div>
</section>
