---
import { Check, Minus } from '@lucide/astro';
import { workbuddyCompare } from '../../data/workbuddy-editions';
import { withBase, type Lang } from '../../data/yi-ai';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const x = workbuddyCompare[lang];
---

{/* Round 43: two product cards side by side, like an online shop's phone comparison; rows line up across them. */}
<section id="compare" class="section wb-compare-section" aria-labelledby="compare-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="compare-title" class="section-title">{x.title}</h2>
      <p class="wb-compare-lead">{x.lead}</p>
    </div>
    <div class="wb-vs" data-reveal>
      <div class="wb-vs-card wb-vs-personal">
        <header class="wb-vs-head">
          <img src={withBase('/partners/workbuddy.svg')} alt="" width="40" height="40" />
          <h3>{x.personal.name}</h3>
          <p>{x.personal.tiers}</p>
        </header>
        <ul role="list">
          {
            x.rows.map(([personal]) => (
              <li>
                <Minus size={16} />
                {personal}
              </li>
            ))
          }
        </ul>
      </div>
      <span class="wb-vs-badge" aria-hidden="true">VS</span>
      <div class="wb-vs-card wb-vs-pro">
        <header class="wb-vs-head">
          <span class="wb-vs-ribbon">{x.enterprise.badge}</span>
          <img src={withBase('/partners/workbuddy.svg')} alt="" width="40" height="40" />
          <h3>{x.enterprise.name}</h3>
          <p>{x.enterprise.tiers}</p>
        </header>
        <ul role="list">
          {
            x.rows.map(([, enterprise]) => (
              <li>
                <Check size={20} />
                {enterprise}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="wb-compare-note">{x.note}</p>
  </div>
</section>
