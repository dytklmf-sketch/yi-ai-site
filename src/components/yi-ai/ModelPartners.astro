---
import { ArrowRight, ArrowUpRight, Check } from '@lucide/astro';
import { modelPartners } from '../../data/model-catalog';
import { inquiryPath, type Lang } from '../../data/yi-ai';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const x = modelPartners[lang];
const zhUI = lang === 'zh';
---

{/* Round 48: self-serve, enterprise volume and referral partners; links outside the site open in a new window. */}
<section id="partners" class="section" aria-labelledby="partners-title">
  <div class="container">
    <h2 id="partners-title" class="section-title" data-reveal>{x.title}</h2>
    <ul class="mp-ways" data-reveal>
      {
        x.ways.map((way) => (
          <li class="mp-way">
            <h3>{way.name}</h3>
            <p class="mp-who">{way.who}</p>
            <ul>
              {way.lines.map((line) => (
                <li>
                  <Check size={15} />
                  {line}
                </li>
              ))}
            </ul>
            {way.action.url ? (
              <a class="text-link" href={way.action.url} target="_blank" rel="noopener noreferrer">
                {way.action.label}
                <ArrowUpRight size={16} />
                <span class="sr-only">{zhUI ? '（新窗口）' : '(new window)'}</span>
              </a>
            ) : (
              <a class="text-link" href={inquiryPath(lang, 'model-services')}>
                {way.action.label}
                <ArrowRight size={16} />
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
