---
import { ArrowRight, BadgeCheck, Cable, MessagesSquare, Server } from '@lucide/astro';
import { home, partners } from '../../data/home';
import { inquiryPath, pathFor, withBase, type Lang } from '../../data/yi-ai';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = home[lang];
// Where each reason can be checked, in the order of `home[lang].why`.
const evidence = [
  { icon: BadgeCheck, href: `${pathFor(lang, 'workbuddy')}#process` },
  { icon: Cable, href: pathFor(lang, 'model-services') },
  { icon: Server, href: pathFor(lang, 'infrastructure') },
  { icon: MessagesSquare, href: inquiryPath(lang) },
];
// The partners sit still in one grid (BRAND.md: no looping motion), in greyscale until hovered so eight brand
// palettes do not compete with the page.
---

<section class="section why-band" id="why" aria-labelledby="why-title">
  <div class="why-bg" aria-hidden="true"><span class="hero-grid-lines"></span></div>
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="why-title" class="section-title">{h.whyTitle}</h2>
    </div>
    <ol class="why-grid">
      {
        h.why.map((reason, i) => {
          const { icon: Icon, href } = evidence[i];
          return (
            <li class="why-card" data-reveal style={`--d:${i}`}>
              <span class="why-line" aria-hidden="true" />
              <span class="why-icon" aria-hidden="true">
                <Icon size={22} />
              </span>
              <h3>{reason.title}</h3>
              <p>{reason.text}</p>
              <a class="text-link why-proof" href={href}>
                {reason.proof}
                <ArrowRight size={16} />
              </a>
            </li>
          );
        })
      }
    </ol>
    {
      partners.length > 0 && (
        <div class="partners-strip" data-reveal>
          <h3 class="partners-kicker">{h.partnersKicker}</h3>
          <ul class="partner-grid">
            {partners.map((partner) => (
              <li class="partner-plate">
                <img
                  src={withBase(partner.logo)}
                  alt={partner[lang]}
                  height={partner.size}
                  style={`--h:${partner.size}px`}
                  decoding="async"
                />
                {partner.wordmark && (
                  <span class="partner-wordmark" aria-hidden="true">
                    {partner.wordmark[0]}
                    <span>{partner.wordmark[1]}</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
