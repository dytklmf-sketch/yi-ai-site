---
import { Copy, ArrowUpRight, Mail, MessageCircle, Check } from '@lucide/astro';
import { contact, services, type Lang } from '../../data/yi-ai';
import { zh } from '../../data/zh';
import { en } from '../../data/en';
interface Props {
  lang: Lang;
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
const t = lang === 'zh' ? zh : en;
const Heading = compact ? 'h3' : 'h2';
const initialLabel = t.services.workbuddy.label;
const topicLabels = {
  workbuddy: 'WorkBuddy',
  'model-services': t.nav.models,
  infrastructure: t.nav.infrastructure,
};
const href = `mailto:${contact.email}?subject=${encodeURIComponent(`${t.contact.subject} | ${initialLabel}`)}&body=${encodeURIComponent(t.contact.emailBody.replace('{topic}', initialLabel))}`;
---

<div
  class:list={['contact-panel', { 'contact-panel-compact': compact }]}
  data-contact-panel
  data-email={contact.email}
  data-subject={t.contact.subject}
  data-body={t.contact.emailBody}
>
  <fieldset class="topic-field" aria-describedby={`contact-topic-hint-${lang}-${compact ? 'compact' : 'full'}`}>
    <legend>{t.contact.topic}</legend>
    <p class="topic-hint" id={`contact-topic-hint-${lang}-${compact ? 'compact' : 'full'}`}>{t.contact.topicHint}</p>
    <div class="topic-options">
      {
        services.map((slug, i) => (
          <label>
            <input type="radio" name="topic" value={slug} checked={i === 0} data-label={t.services[slug].label} />
            <span>
              {topicLabels[slug]}
              <Check size={14} aria-hidden="true" />
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>
  <div class="contact-options">
    <section class="contact-option">
      <div class="contact-symbol"><MessageCircle size={26} stroke-width={1.4} /></div>
      <Heading>{t.contact.wechatTitle}</Heading><p>{t.contact.wechatText}</p>
      <span class="contact-id" tabindex="0">{contact.wechat}</span>
      <button
        type="button"
        class="button button-primary copy-button"
        data-copy={contact.wechat}
        data-success={t.contact.copied}
        data-failure={t.contact.fallback}
        aria-describedby={`contact-copy-status-${lang}-${compact ? 'compact' : 'full'}`}
        ><Copy size={16} />{t.contact.copy}</button
      >
      <p
        class="copy-status"
        id={`contact-copy-status-${lang}-${compact ? 'compact' : 'full'}`}
        role="status"
        aria-live="polite"
      >
      </p>
    </section>
    <section class="contact-option">
      <div class="contact-symbol blue"><Mail size={26} stroke-width={1.4} /></div>
      <Heading>{t.contact.emailTitle}</Heading><p>{t.contact.emailText}</p>
      <a class="contact-id email-address" href={`mailto:${contact.email}`}>{contact.email}</a>
      <a class="button button-outline inquiry-email" href={href}>{t.contact.emailAction}<ArrowUpRight size={17} /></a>
    </section>
  </div>
  <div class="topic-preparation" aria-live="polite">
    <span>{t.contact.prepare}</span>
    {
      services.map((slug, i) => (
        <p data-topic-preparation={slug} hidden={i !== 0}>
          {t.services[slug].preparation.join(lang === 'zh' ? '、' : ' · ')}
        </p>
      ))
    }
  </div>
  <p class="contact-note">{t.contact.note}</p>
  <noscript
    ><p class="contact-note">
      {
        lang === 'zh'
          ? '你可以直接选择微信号手动复制，或在邮件中注明所需业务。'
          : 'Select the WeChat ID to copy it manually, or mention your service of interest in the email.'
      }
    </p></noscript
  >
</div>
<script src="../../scripts/contact.ts"></script>
