---
import { Copy, ArrowUpRight, Mail, MessageCircle, Check, Download } from '@lucide/astro';
import { contact, services, withBase, type Lang, type Service } from '../../data/yi-ai';
import { serviceBriefs } from '../../data/workbuddy-editions';
import { zh } from '../../data/zh';
import { en } from '../../data/en';
import ServiceIcon from './ServiceIcon.astro';
interface Props {
  lang: Lang;
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
const t = lang === 'zh' ? zh : en;
const Heading = compact ? 'h3' : 'h2';
const key = `${lang}-${compact ? 'compact' : 'full'}`;
const initialLabel = t.services.workbuddy.label;
// Round 56: one short line per topic card, short enough to stay on one line beside the mark.
const topicNotes: Record<Service, string> =
  lang === 'zh'
    ? { workbuddy: '企业版采购与续费', 'model-services': '模型 API 与企业用量', infrastructure: '自建机房 · 私有化' }
    : {
        workbuddy: 'Enterprise seats',
        'model-services': 'Model APIs & volume',
        infrastructure: 'Data center & hosting',
      };
const topicLabels = {
  workbuddy: 'WorkBuddy',
  'model-services': t.nav.models,
  infrastructure: t.nav.infrastructure,
};
// Round 34: each topic pre-fills the email with its own quote inputs, in place of one generic template.
const bodyFor = (slug: Service) =>
  lang === 'zh'
    ? `您好，易AI：\n\n咨询方向：{topic}\n公司或团队：\n${t.services[slug].preparation.map((item) => `${item}：`).join('\n')}\n期望开始时间：\n\n谢谢！`
    : `Hello Easy AI,\n\nTopic: {topic}\nCompany or team:\n${t.services[slug].preparation.map((item) => `${item}:`).join('\n')}\nPreferred start date:\n\nThank you.`;
const brief = (slug: Service) => serviceBriefs[lang][slug];
const href = `mailto:${contact.email}?subject=${encodeURIComponent(`${t.contact.subject} | ${initialLabel}`)}&body=${encodeURIComponent(bodyFor('workbuddy').replace('{topic}', initialLabel))}`;
---

{
  /* Round 56: the panel takes the colour of the chosen service (CSS :has, so it also works without JS), carries the
    shared card light, and both contact methods share one layout so the IDs and buttons line up. */
}
<div
  class:list={['contact-panel', 'glow-card', { 'contact-panel-compact': compact }]}
  data-contact-panel
  data-glow
  data-email={contact.email}
  data-subject={t.contact.subject}
  data-body={t.contact.emailBody}
>
  <fieldset class="topic-field">
    <legend><span class="step-tag">1</span>{t.contact.topic}</legend>
    <div class="topic-options">
      {
        services.map((slug, i) => (
          <label>
            <input
              type="radio"
              name="topic"
              value={slug}
              checked={i === 0}
              data-label={t.services[slug].label}
              data-body={bodyFor(slug)}
            />
            <span>
              <ServiceIcon service={slug} size={34} tile brand class="topic-mark" />
              <span class="topic-text">
                <strong>{topicLabels[slug]}</strong>
                <small>{topicNotes[slug]}</small>
              </span>
              <Check size={15} aria-hidden="true" />
            </span>
          </label>
        ))
      }
    </div>
    <div class="topic-preparation" aria-live="polite">
      <span class="micro-label">{t.contact.prepare}</span>
      {
        services.map((slug, i) => (
          <p data-topic-preparation={slug} hidden={i !== 0}>
            {t.services[slug].preparation.join(lang === 'zh' ? '、' : ' · ')}
            <a class="topic-brief" href={withBase(`/templates/${lang}/${brief(slug).file}`)} download>
              <Download size={14} />
              {lang === 'zh' ? `下载${brief(slug).label}` : `Download the ${brief(slug).label.toLowerCase()}`}
            </a>
          </p>
        ))
      }
    </div>
  </fieldset>
  <p class="contact-step">
    <span class="step-tag">2</span>{lang === 'zh' ? '选择联系方式' : 'Choose how to reach us'}
  </p>
  <div class="contact-options">
    <section class="contact-option glow-card" data-glow>
      <div class="contact-option-head">
        <span class="contact-symbol"><MessageCircle size={20} stroke-width={1.6} /></span>
        <Heading>{t.contact.wechatTitle}</Heading>
      </div>
      <p>{t.contact.wechatText}</p>
      <span class="contact-id mono" tabindex="0">{contact.wechat}</span>
      <button
        type="button"
        class="btn btn-primary copy-button"
        data-copy={contact.wechat}
        data-success={t.contact.copied}
        data-failure={t.contact.fallback}
        aria-describedby={`contact-copy-status-${key}`}
        ><Copy size={16} /><span class="copy-label">{t.contact.copy}</span></button
      >
      <p class="copy-status" id={`contact-copy-status-${key}`} role="status" aria-live="polite"></p>
    </section>
    <section class="contact-option glow-card" data-glow>
      <div class="contact-option-head">
        <span class="contact-symbol"><Mail size={20} stroke-width={1.6} /></span>
        <Heading>{t.contact.emailTitle}</Heading>
      </div>
      <p>{t.contact.emailText}</p>
      <a class="contact-id email-address mono" href={`mailto:${contact.email}`}>{contact.email}</a>
      <a class="btn btn-outline inquiry-email" href={href}>{t.contact.emailAction}<ArrowUpRight size={17} /></a>
      <p class="contact-hint">
        {
          lang === 'zh'
            ? '邮件会预填所选业务和需要准备的信息。'
            : 'The email comes pre-filled with your topic and what to prepare.'
        }
      </p>
    </section>
  </div>
  <p class="contact-note">{t.contact.note}</p>
  <noscript
    ><p class="contact-note">
      {
        lang === 'zh'
          ? '可直接选择微信号手动复制，或在邮件中注明所需业务。'
          : 'Select the WeChat ID to copy it manually, or mention your service of interest in the email.'
      }
    </p></noscript
  >
</div>
<script src="../../scripts/contact.ts"></script>
