---
import { Copy, ArrowUpRight, Mail, MessageCircle, Check } from '@lucide/astro';
import { contact, services, type Lang } from '../../data/yi-ai';
import { zh } from '../../data/zh';
import { en } from '../../data/en';
import ServiceIcon from './ServiceIcon.astro';
interface Props {
  lang: Lang;
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
const t = lang === 'zh' ? zh : en;
const Heading = compact ? 'h3' : 'h2';
const key = `${lang}-${compact ? 'compact' : 'full'}`;
const initialLabel = t.services.workbuddy.label;
const topicLabels = {
  workbuddy: 'WorkBuddy',
  'model-services': t.nav.models,
  infrastructure: t.nav.infrastructure,
};
const href = `mailto:${contact.email}?subject=${encodeURIComponent(`${t.contact.subject} | ${initialLabel}`)}&body=${encodeURIComponent(t.contact.emailBody.replace('{topic}', initialLabel))}`;
---

<div
  class:list={['contact-panel', { 'contact-panel-compact': compact }]}
  data-contact-panel
  data-email={contact.email}
  data-subject={t.contact.subject}
  data-body={t.contact.emailBody}
>
  <fieldset class="topic-field">
    <legend><span class="step-tag mono">01</span>{t.contact.topic}</legend>
    <div class="topic-options">
      {
        services.map((slug, i) => (
          <label>
            <input type="radio" name="topic" value={slug} checked={i === 0} data-label={t.services[slug].label} />
            <span>
              <ServiceIcon service={slug} size={16} class="topic-code" />
              {topicLabels[slug]}
              <Check size={15} aria-hidden="true" />
            </span>
          </label>
        ))
      }
    </div>
    <div class="topic-preparation" aria-live="polite">
      <span class="micro-label">{t.contact.prepare}</span>
      {
        services.map((slug, i) => (
          <p data-topic-preparation={slug} hidden={i !== 0}>
            {t.services[slug].preparation.join(lang === 'zh' ? '、' : ' · ')}
          </p>
        ))
      }
    </div>
  </fieldset>
  <p class="contact-step">
    <span class="step-tag mono">02</span>{lang === 'zh' ? '选择联系方式' : 'Choose how to reach us'}
  </p>
  <div class="contact-options">
    <section class="contact-option">
      <div class="contact-option-head">
        <span class="contact-symbol"><MessageCircle size={20} stroke-width={1.6} /></span>
        <Heading>{t.contact.wechatTitle}</Heading>
      </div>
      <p>{t.contact.wechatText}</p>
      <span class="contact-id mono" tabindex="0">{contact.wechat}</span>
      <button
        type="button"
        class="btn btn-primary copy-button"
        data-copy={contact.wechat}
        data-success={t.contact.copied}
        data-failure={t.contact.fallback}
        aria-describedby={`contact-copy-status-${key}`}
        ><Copy size={16} /><span class="copy-label">{t.contact.copy}</span></button
      >
      <p class="copy-status" id={`contact-copy-status-${key}`} role="status" aria-live="polite"></p>
    </section>
    <section class="contact-option">
      <div class="contact-option-head">
        <span class="contact-symbol"><Mail size={20} stroke-width={1.6} /></span>
        <Heading>{t.contact.emailTitle}</Heading>
      </div>
      <p>{t.contact.emailText}</p>
      <a class="contact-id email-address mono" href={`mailto:${contact.email}`}>{contact.email}</a>
      <a class="btn btn-outline inquiry-email" href={href}>{t.contact.emailAction}<ArrowUpRight size={17} /></a>
    </section>
  </div>
  <p class="contact-note">{t.contact.note}</p>
  <noscript
    ><p class="contact-note">
      {
        lang === 'zh'
          ? '可直接选择微信号手动复制，或在邮件中注明所需业务。'
          : 'Select the WeChat ID to copy it manually, or mention your service of interest in the email.'
      }
    </p></noscript
  >
</div>
<script src="../../scripts/contact.ts"></script>
