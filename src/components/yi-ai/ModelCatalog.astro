---
import { ArrowUpRight, Images } from '@lucide/astro';
import { modelCatalog, modelLinks } from '../../data/model-catalog';
import { withBase, type Lang } from '../../data/yi-ai';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const x = modelCatalog[lang];
const zhUI = lang === 'zh';
---

{
  /* Round 48: the model catalog in CCG API purple, laid out like WorkBuddy's pricing panel. Round 50: each family
    gets a tile and a faint corner tint in its own colour (round 51: the vendor's logo on white, the monogram as a fallback); cards rise in once with a sheen, and a soft light
    follows the pointer (data-glow, interactions.ts). The family's models are chips, the first one tinted. */
}
<section id="models" class="section mc-section" aria-labelledby="models-title">
  <div class="container">
    <div class="mc-panel" data-reveal>
      <header class="mc-head">
        <p class="mc-mark">
          <img src={withBase('/partners/ccg-api.svg')} alt="" width="28" height="28" />
          <span class="mono">CCG API</span>
          <span class="mc-label">{x.label}</span>
        </p>
        <h2 id="models-title" class="mc-title">
          {x.title[0]}<em>{x.title[1]}</em>
        </h2>
        <div class="mc-cta">
          <a class="btn btn-primary" href={modelLinks.catalog} target="_blank" rel="noopener noreferrer">
            {zhUI ? '打开模型广场' : 'Open the catalog'}
            <ArrowUpRight size={17} />
            <span class="sr-only">{zhUI ? '（新窗口）' : '(new window)'}</span>
          </a>
          <p class="mc-note">{x.note}</p>
        </div>
      </header>
      <ul class="mc-families">
        {
          x.families.map((family, i) => (
            <li class="mc-family glow-card" style={`--fam:${family.color};--i:${i}`} data-glow>
              <span class="card-sheen" aria-hidden="true" />
              <header class="mc-family-head">
                <span class="mc-tile" aria-hidden="true">
                  {family.icon ? (
                    <img src={withBase(`/models/${family.icon}`)} alt="" width="22" height="22" />
                  ) : (
                    family.mark || <Images size={20} />
                  )}
                </span>
                <div class="mc-family-name">
                  <h3>{family.name}</h3>
                  {family.maker && <p class="mc-maker">{family.maker}</p>}
                </div>
                <span class="mc-region">{family.region}</span>
              </header>
              <ul class="mc-models">
                {family.models.map((model) => (
                  <li>
                    <code>{model}</code>
                  </li>
                ))}
              </ul>
              <ul class="mc-tags">
                {family.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
