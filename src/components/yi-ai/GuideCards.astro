---
import { ArrowUpRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import { articlePath, type Lang } from '../../data/yi-ai';
import { editorial } from '../../data/editorial';
import { zh } from '../../data/zh';
import { en } from '../../data/en';
import ServiceIcon from './ServiceIcon.astro';
interface Props {
  lang: Lang;
  guides: CollectionEntry<'guides'>[];
  featured?: boolean;
}
const { lang, guides, featured = false } = Astro.props;
const t = lang === 'zh' ? zh : en;
// Every guide opens with 先给结论 and 适用条件 and closes with 常见问题, so those headings say nothing about this
// particular guide. The middle sections are what actually differ, and the two languages carry the same ones in the
// same order, so the card can list them without the pairing drifting apart.
const bodySections = (body: string) => [...body.matchAll(/^##\s+(.+)$/gm)].map((m) => m[1].trim()).slice(2, -1);
---

<div class:list={['guide-grid', { 'guide-grid-featured': featured }]}>
  {
    guides.map(({ data, body }, i) => {
      const sections = body ? bodySections(body) : [];
      return (
        <a
          class="guide-card"
          href={articlePath(lang, data.pairKey)}
          data-service={data.service}
          data-reveal
          style={`--d:${i % 3}`}
        >
          <span class="guide-label">
            <ServiceIcon service={data.service} size={16} tile />
            {t.services[data.service].label}
          </span>
          <h3>{data.title}</h3>
          <p class="guide-desc">{data.description}</p>
          {sections.length > 0 && (
            <p class="guide-contents">
              <span class="guide-contents-label mono">{editorial[lang].guideContents}</span>
              {sections.join(' · ')}
            </p>
          )}
          <span class="guide-foot">
            <span class="guide-link">
              {editorial[lang].readGuide}
              <span class="guide-arrow">
                <ArrowUpRight size={16} />
              </span>
            </span>
            <span class="guide-meta">
              {editorial[lang].updated}{' '}
              <time class="mono" datetime={data.updatedAt}>
                {data.updatedAt}
              </time>
            </span>
          </span>
        </a>
      );
    })
  }
</div>
