---
import { ArrowUpRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import { articlePath, type Lang } from '../../data/yi-ai';
import { editorial } from '../../data/editorial';
import { zh } from '../../data/zh';
import { en } from '../../data/en';
import ServiceIcon from './ServiceIcon.astro';
interface Props {
  lang: Lang;
  guides: CollectionEntry<'guides'>[];
  featured?: boolean;
}
const { lang, guides, featured = false } = Astro.props;
const t = lang === 'zh' ? zh : en;
// The card lists what a guide actually covers: its section headings, minus the generic ones (summary, scope, FAQ)
// that older guides share. The update date stays off the page (round 38).
const generic = new Set([
  '先给结论',
  '适用条件',
  '常见误区',
  '常见问题',
  'The short answer',
  'When this applies',
  'Common mistakes',
  'FAQ',
]);
const bodySections = (body: string) =>
  [...body.matchAll(/^##\s+(.+)$/gm)].map((m) => m[1].trim()).filter((heading) => !generic.has(heading));
---

<div class:list={['guide-grid', { 'guide-grid-featured': featured }]}>
  {
    guides.map(({ data, body }, i) => {
      const sections = body ? bodySections(body) : [];
      return (
        <a
          class="guide-card"
          href={articlePath(lang, data.pairKey)}
          data-service={data.service}
          data-reveal
          style={`--d:${i % 3}`}
        >
          <span class="guide-label">
            <ServiceIcon service={data.service} size={16} tile />
            {t.services[data.service].label}
          </span>
          <h3>{data.title}</h3>
          <p class="guide-desc">{data.description}</p>
          {sections.length > 0 && (
            <p class="guide-contents">
              <span class="guide-contents-label mono">{editorial[lang].guideContents}</span>
              {sections.join(' · ')}
            </p>
          )}
          <span class="guide-foot">
            <span class="guide-link">
              {editorial[lang].readGuide}
              <span class="guide-arrow">
                <ArrowUpRight size={16} />
              </span>
            </span>
          </span>
        </a>
      );
    })
  }
</div>
