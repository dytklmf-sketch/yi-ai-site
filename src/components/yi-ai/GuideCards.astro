---
import { ArrowUpRight, BookOpen } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import { articlePath, type Lang } from '../../data/yi-ai';
import { editorial } from '../../data/editorial';
import { refinement } from '../../data/refinement';
import { zh } from '../../data/zh';
import { en } from '../../data/en';
interface Props {
  lang: Lang;
  guides: CollectionEntry<'guides'>[];
  featured?: boolean;
}
const { lang, guides, featured = false } = Astro.props;
const t = lang === 'zh' ? zh : en;
const r = refinement[lang];
---

<div class:list={['guide-grid', { 'guide-grid-featured': featured }]}>
  {
    guides.map(({ data }, i) => (
      <a class="guide-card" href={articlePath(lang, data.pairKey)} data-reveal data-delay={i % 3}>
        <div class="guide-label">
          <>
            <BookOpen size={18} />
            <span>{t.services[data.service].label}</span>
          </>
        </div>
        <h3>{data.title}</h3>
        <span class="guide-audience">
          {r.guideAudience} · {r.audiences[data.service]}
        </span>
        <p>{data.description}</p>
        {featured && (
          <ul class="guide-preview">
            {r.guideChecks[data.service].map((item, index) => (
              <li>
                <span aria-hidden="true">0{index + 1}</span>
                {item}
              </li>
            ))}
          </ul>
        )}
        <div class="guide-meta">
          <>
            <span>{r.guideType}</span>
            <time datetime={data.updatedAt}>{data.updatedAt}</time>
          </>
        </div>
        <span class="card-link">
          {editorial[lang].readGuide}
          <ArrowUpRight size={18} />
        </span>
      </a>
    ))
  }
</div>
