---
import { ArrowUpRight, Check, Download } from '@lucide/astro';
import { serviceBriefs, workbuddyEditions } from '../../data/workbuddy-editions';
import { certificateIssuer, parentCompany, workbuddyCredential } from '../../data/yi-ai';
import { withBase, type Lang } from '../../data/yi-ai';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const x = workbuddyEditions[lang];
const zhUI = lang === 'zh';
const brief = serviceBriefs[lang].workbuddy;
const cert = withBase(workbuddyCredential.certificate);
---

<section id="editions" class="section wb-editions-section" aria-labelledby="editions-title">
  <div class="container">
    <div class="wb-editions" data-reveal>
      <header class="wb-editions-head">
        <p class="wb-editions-mark">
          <img src={withBase('/partners/workbuddy.svg')} alt="" width="28" height="28" />
          <img
            class="wb-wordmark"
            src={withBase('/partners/workbuddy-wordmark.svg')}
            alt="WorkBuddy"
            width="65"
            height="28"
          />
          <span class="wb-editions-label">{x.label}</span>
        </p>
        <h2 id="editions-title" class="wb-editions-title">
          {x.title[0]}<em>{x.title[1]}</em>
        </h2>
        <p class="wb-editions-lead">{x.lead}</p>
      </header>
      <ul class="wb-tiers">
        {
          x.tiers.map((tier) => (
            <li class="wb-tier">
              <h3>{tier.name}</h3>
              <p class="wb-price">
                <strong>{tier.price}</strong>
                {tier.unit && <span>{tier.unit}</span>}
              </p>
              <ul>
                {tier.lines.map((line) => (
                  <li>
                    <Check size={15} />
                    {line}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <a class="wb-cert" href={cert} target="_blank" rel="noopener noreferrer">
        <img
          src={cert}
          alt={zhUI
            ? `腾讯云 WorkBuddy / CodeBuddy 官方授权合作伙伴证书，授权单位：${certificateIssuer.zh}，被授权方：${parentCompany.name.zh}`
            : `Tencent Cloud WorkBuddy / CodeBuddy authorized-partner certificate, issued by ${certificateIssuer.en} to ${parentCompany.name.en}`}
          width="1200"
          height="848"
          loading="lazy"
          decoding="async"
        />
        <span class="wb-cert-copy">
          <strong>{workbuddyCredential.partner[lang]}</strong>
          <span>
            {
              zhUI
                ? `授权单位：${certificateIssuer.zh}；被授权方：${parentCompany.name.zh}（大鱼出海）。易AI 是大鱼出海旗下子公司，负责 WorkBuddy 项目落地实施。`
                : `Issued by ${certificateIssuer.en} to ${parentCompany.name.en} (DAYUSEA). Easy AI, a DAYUSEA subsidiary, delivers WorkBuddy projects.`
            }
          </span>
        </span>
        <span class="wb-cert-view">
          {zhUI ? '查看证书' : 'View certificate'}
          <ArrowUpRight size={14} />
          <span class="sr-only">{zhUI ? '（新窗口）' : '(new window)'}</span>
        </span>
      </a>
      <footer class="wb-editions-foot">
        <ul class="wb-rules" aria-label={zhUI ? '采购前要知道的规则' : 'Rules to know before buying'}>
          {x.rules.map((rule) => <li>{rule}</li>)}
        </ul>
        <a class="btn btn-wb" href={withBase(`/templates/${lang}/${brief.file}`)} download>
          <Download size={17} />
          {zhUI ? `下载${brief.label}` : `Download the ${brief.label.toLowerCase()}`}
        </a>
        <p class="wb-editions-note">
          {x.note}
          {
            x.sources.map((source) => (
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.label}
                <ArrowUpRight size={13} />
                <span class="sr-only">{zhUI ? '（新窗口）' : '(new window)'}</span>
              </a>
            ))
          }
        </p>
      </footer>
    </div>
  </div>
</section>
