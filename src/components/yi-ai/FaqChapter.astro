---
import { ArrowRight, ArrowUpRight, Plus } from '@lucide/astro';
import { home } from '../../data/home';
import { editorial } from '../../data/editorial';
import { services, inquiryPath, pathFor, type Lang } from '../../data/yi-ai';
import { zh } from '../../data/zh';
import { en } from '../../data/en';

interface Props {
  lang: Lang;
  /** Home shows the first question of each service and links to the FAQ page; the FAQ page shows all with a filter. */
  full?: boolean;
}
const { lang, full = false } = Astro.props;
const t = lang === 'zh' ? zh : en;
const h = home[lang];
const serviceLabels = {
  workbuddy: t.nav.workbuddy,
  'model-services': t.nav.models,
  infrastructure: t.nav.infrastructure,
};
const grouped = services.flatMap((service) => t.faq.filter((item) => item.service === service));
const items = full ? grouped : services.map((service) => grouped.find((item) => item.service === service)!);
---

{
  /* Round 78: on the home page the three questions sit in one row under the title, and the block reveals as one (the
    title row alone is too short for WebKit to catch reliably); the FAQ page keeps the side column. */
}
<section class:list={['section faq-band', { 'faq-home': !full }]} id="faq" aria-labelledby="faq-title">
  <div class="container faq-layout" data-reveal={full ? undefined : ''}>
    <div class="faq-aside" data-reveal={full ? '' : undefined}>
      <h2 id="faq-title" class="section-title">{t.faqTitle}</h2>
      {
        full && (
          <div
            class="faq-filter"
            data-faq-filter
            hidden
            role="group"
            aria-label={lang === 'zh' ? '按业务筛选' : 'Filter by service'}
          >
            <button type="button" aria-pressed="true" data-filter="all">
              {h.faqAll}
            </button>
            {services.map((slug) => (
              <button type="button" aria-pressed="false" data-filter={slug}>
                {serviceLabels[slug]}
              </button>
            ))}
          </div>
        )
      }
      {
        !full && (
          <a class="text-link" href={pathFor(lang, 'faq')}>
            {editorial[lang].faqAllLink}
            <ArrowRight size={16} />
          </a>
        )
      }
      <a class="text-link" href={inquiryPath(lang)}>{t.primary}<ArrowUpRight size={16} /></a>
    </div>
    <div class="faq-list" data-reveal={full ? '' : undefined}>
      {
        items.map((item) => (
          <details data-service={item.service}>
            <summary>
              <span class="faq-question">
                <small>{serviceLabels[item.service]}</small>
                {item.question}
              </span>
              <span class="faq-toggle" aria-hidden="true">
                <Plus size={18} />
              </span>
            </summary>
            <div class="disclosure-content">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
