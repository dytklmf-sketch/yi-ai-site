---
import { ArrowUpRight, Plus } from '@lucide/astro';
import { home } from '../../data/home';
import { services, inquiryPath, type Lang } from '../../data/yi-ai';
import { zh } from '../../data/zh';
import { en } from '../../data/en';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = lang === 'zh' ? zh : en;
const h = home[lang];
const serviceLabels = {
  workbuddy: t.nav.workbuddy,
  'model-services': t.nav.models,
  infrastructure: t.nav.infrastructure,
};
---

<section class="section faq-band" id="faq" aria-labelledby="faq-title">
  <div class="container faq-layout">
    <div class="faq-aside" data-reveal>
      <h2 id="faq-title" class="section-title">{t.faqTitle}</h2>
      <div
        class="faq-filter"
        data-faq-filter
        hidden
        role="group"
        aria-label={lang === 'zh' ? '按业务筛选' : 'Filter by service'}
      >
        <button type="button" aria-pressed="true" data-filter="all">{h.faqAll}</button>
        {
          services.map((slug) => (
            <button type="button" aria-pressed="false" data-filter={slug}>
              {serviceLabels[slug]}
            </button>
          ))
        }
      </div>
      <a class="text-link" href={inquiryPath(lang)}>{t.primary}<ArrowUpRight size={16} /></a>
    </div>
    <div class="faq-list" data-reveal>
      {
        t.faq.map((item, i) => (
          <details data-service={item.service}>
            <summary>
              <span class="faq-number mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq-question">
                <small>{serviceLabels[item.service]}</small>
                {item.question}
              </span>
              <span class="faq-toggle" aria-hidden="true">
                <Plus size={18} />
              </span>
            </summary>
            <div class="disclosure-content">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
