---
import '../styles/yi-ai.css';
import { ArrowUpRight, Globe, Menu, Plus, MessageCircle } from '@lucide/astro';
import BrandMark from '../components/yi-ai/BrandMark.astro';
import {
  brandName,
  contact,
  pathFor,
  inquiryPath,
  articlePath,
  shareImage,
  navigationPages,
  type Lang,
  type SitePage,
  type Service,
} from '../data/yi-ai';
import { editorial } from '../data/editorial';
import { getRoutes } from '../data/routes';
import { zh } from '../data/zh';
import { en } from '../data/en';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  slug?: SitePage;
  article?: string;
  service?: Service;
  structuredData?: Record<string, unknown>;
  notFound?: boolean;
  homeChapters?: boolean;
}
const { lang, slug, article, service, structuredData } = Astro.props;
const currentPath = article ? articlePath(lang, article) : pathFor(lang, slug);
const route = Astro.props.notFound ? undefined : (await getRoutes()).find((entry) => entry.path === currentPath);
const title = route?.title ?? Astro.props.title;
const description = route?.description ?? Astro.props.description;
const t = lang === 'zh' ? zh : en;
const brand = brandName(lang);
const labels = {
  home: t.nav.home,
  workbuddy: t.nav.workbuddy,
  'model-services': t.nav.models,
  infrastructure: t.nav.infrastructure,
  contact: t.nav.contact,
  resources: editorial[lang].resources,
  about: editorial[lang].about,
};
const links = navigationPages.map((page) => ({
  href: pathFor(lang, page),
  text: labels[page || 'home'],
  active: slug === page,
}));
const otherLang = lang === 'zh' ? 'en' : 'zh';
const alternatePath = (locale: Lang) => (article ? articlePath(locale, article) : pathFor(locale, slug));
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: brand,
  alternateName: brandName(otherLang),
  description,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  about: { '@type': 'Brand', name: brand, alternateName: brandName(otherLang) },
};
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-lang={lang} class:list={{ 'home-story': Astro.props.homeChapters }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | ${brand}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={brand} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={shareImage(lang, slug, article)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} | ${brand}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/brand/favicon.svg?v=whale-a" type="image/svg+xml" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    {
      lang === 'zh' && (
        <link rel="preload" href="/fonts/noto-sans-sc-site.woff2" as="font" type="font/woff2" crossorigin />
      )
    }
    <link rel="alternate" hreflang="zh-CN" href={alternatePath('zh')} />
    <link rel="alternate" hreflang="en" href={alternatePath('en')} />
    <title>{title} | {brand}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    {
      structuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')}
        />
      )
    }
  </head>
  <body class:list={{ 'has-mobile-inquiry': slug !== 'contact' }}>
    <a class="skip-link" href="#main">{lang === 'zh' ? '跳转到正文' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="site-container nav-row">
        <BrandMark lang={lang} />
        <nav class="desktop-nav" aria-label={lang === 'zh' ? '主导航' : 'Primary navigation'}>
          {
            links.map((link) => (
              <a href={link.href} aria-current={link.active ? 'page' : undefined}>
                {link.text}
              </a>
            ))
          }
        </nav>
        <div class="nav-actions">
          <a
            class="language-link"
            href={alternatePath(otherLang)}
            lang={otherLang}
            aria-label={lang === 'zh' ? 'Switch to English' : '切换到中文'}><Globe size={15} />{t.otherLanguage}</a
          >
          <a class="button button-primary header-cta" href={inquiryPath(lang, service)}
            >{t.nav.contact}<ArrowUpRight size={16} /></a
          >
          <details class="mobile-menu">
            <summary aria-label={lang === 'zh' ? '导航菜单' : 'Navigation menu'}><Menu size={22} /></summary>
            <nav aria-label={lang === 'zh' ? '移动端导航' : 'Mobile navigation'}>
              {
                links.map((link) => (
                  <a href={link.href} aria-current={link.active ? 'page' : undefined}>
                    {link.text}
                  </a>
                ))
              }
              <a href={inquiryPath(lang, service)}>{t.nav.contact}<ArrowUpRight size={17} /></a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="site-container footer-grid">
        <div class="footer-brand"><BrandMark lang={lang} compact /><p>{t.promise.join(' ')}</p></div>
        <div>
          <p class="footer-label">{lang === 'zh' ? '我们的服务' : 'OUR SERVICES'}</p>
          <nav class="footer-links" aria-label={lang === 'zh' ? '页脚导航' : 'Footer navigation'}>
            {links.slice(1).map((link) => <a href={link.href}>{link.text}</a>)}
          </nav>
        </div>
        <div>
          <p class="footer-label">{lang === 'zh' ? '保持联系' : 'GET IN TOUCH'}</p>
          <div class="footer-links">
            <a href={`mailto:${contact.email}`}>{contact.email}<ArrowUpRight size={14} /></a>
            <a href={pathFor(lang, 'contact')}>{lang === 'zh' ? '微信' : 'WeChat'} · {contact.wechat}</a>
            <a href={pathFor(lang, 'contact')}>{t.nav.contact}<Plus size={14} /></a>
          </div>
        </div>
      </div>
      <div class="site-container footer-bottom">
        <span>© 2026 {brand}</span>
        <span>{lang === 'zh' ? '让技术走进真实业务。' : 'Technology, for real work.'}</span>
        <a href={alternatePath(otherLang)} lang={otherLang}
          >{lang === 'zh' ? 'English version' : '中文版'}<Globe size={13} /></a
        >
      </div>
    </footer>
    {
      slug !== 'contact' && (
        <div class="mobile-inquiry">
          <a
            class="button button-primary"
            href={inquiryPath(lang, service)}
            aria-label={`${t.nav.contact}: ${t.primary}`}
          >
            <MessageCircle size={18} />
            {t.primary}
            <ArrowUpRight size={18} />
          </a>
        </div>
      )
    }
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
