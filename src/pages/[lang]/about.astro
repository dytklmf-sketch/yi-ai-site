---
import YiAiLayout from '../../layouts/YiAiLayout.astro';
import WidgetWrapper from '../../components/ui/WidgetWrapper.astro';
import CallToAction from '../../components/yi-ai/CallToAction.astro';
import { ArrowUpRight } from '@lucide/astro';
import { editorial } from '../../data/editorial';
import { brandName, pathFor, services, type Lang } from '../../data/yi-ai';
import { languages } from '../../data/routes';
import { zh } from '../../data/zh';
import { en } from '../../data/en';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const e = editorial[lang];
const t = lang === 'zh' ? zh : en;
---

<YiAiLayout lang={lang} slug="about" title={e.aboutTitle} description={e.aboutIntro}>
  <section class="page-hero">
    <div class="site-container">
      <nav class="breadcrumb" aria-label={lang === 'zh' ? '面包屑导航' : 'Breadcrumb'}>
        <a href={pathFor(lang)}>{brandName(lang)}</a><span>/</span><span>{e.about}</span>
      </nav>
      <div class="page-hero-grid">
        <div><p class="eyebrow">{brandName(lang)}</p><h1>{e.aboutTitle}</h1></div><div class="page-hero-copy">
          <p>{e.aboutIntro}</p>
        </div>
      </div>
    </div>
  </section>
  <WidgetWrapper id="capabilities">
    <div class="section-head"><h2>{e.aboutLead}</h2><p class="section-intro">{e.aboutBody}</p></div>
    <div class="service-grid">
      {
        services.map((service, i) => (
          <a class:list={['service-card', `service-${i}`]} href={pathFor(lang, service)} data-reveal data-delay={i}>
            <>
              <span class="card-number">0{i + 1}</span>
              <h3>{t.principles[i].title}</h3>
              <p>{t.principles[i].text}</p>
              <span class="card-link">
                {t.explore}
                <ArrowUpRight size={18} />
              </span>
            </>
          </a>
        ))
      }
    </div>
  </WidgetWrapper>
  <WidgetWrapper class="manifest-band">
    <div class="manifest-grid">
      <div><p class="eyebrow">{e.about}</p><h2>{e.principlesTitle}</h2></div><div class="principles">
        {
          e.principles.map((item, i) => (
            <div class="principle">
              <>
                <span>0{i + 1}</span>
                <div>
                  <>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </>
                </div>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </WidgetWrapper>
  <WidgetWrapper id="relationship">
    <div class="detail-grid">
      <h2>{e.relationshipTitle}</h2><div class="relationship-copy">
        <p>{e.relationshipBody}</p>
        <dl class="brand-relationship">
          <div>
            <dt>易AI / Easy AI</dt><dd>
              {
                lang === 'zh'
                  ? '企业 AI 应用、模型服务与基础设施的业务合作品牌。'
                  : 'The cooperation brand for enterprise AI, model services and infrastructure.'
              }
            </dd>
          </div>
          <div>
            <dt>CCG</dt><dd>
              {
                lang === 'zh'
                  ? '模型 API 服务中的产品入口，使用独立的产品网站。'
                  : 'A model API product entry with its own product website.'
              }
            </dd>
          </div>
        </dl>
        <a class="text-link" href={pathFor(lang, 'model-services')}>{t.nav.models}<ArrowUpRight size={18} /></a>
      </div>
    </div>
  </WidgetWrapper>
  <CallToAction lang={lang} />
</YiAiLayout>
