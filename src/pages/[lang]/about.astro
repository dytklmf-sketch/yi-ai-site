---
import YiAiLayout from '../../layouts/YiAiLayout.astro';
import { ArrowUpRight, ArrowRight } from '@lucide/astro';
import { editorial } from '../../data/editorial';
import { home } from '../../data/home';
import { brandName, modelProduct, pathFor, services, withBase, type Lang } from '../../data/yi-ai';
import { languages } from '../../data/routes';
import { zh } from '../../data/zh';
import { en } from '../../data/en';
import ServiceIcon from '../../components/yi-ai/ServiceIcon.astro';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const e = editorial[lang];
const t = lang === 'zh' ? zh : en;
const h = home[lang];
const zhUI = lang === 'zh';
// The positioning line with every 易 / "easy" picked out, as in the brand film's end card.
const slogan = h.heroSlogan.split(/(易|easy)/);
const whale = `--whale:url(${withBase('/brand/logo-symbol.svg')})`;
---

<YiAiLayout lang={lang} slug="about" title={e.aboutTitle} description={e.aboutIntro} chapters darkHero>
  <section class="hero about-hero">
    <div class="hero-bg about-bg" aria-hidden="true">
      <span class="hero-grid-lines"></span>
      <span class="hud-rings"></span>
      <span class="hud-scan"></span>
      <span class="hud-floor"></span>
    </div>
    <div class="container about-hero-layout">
      <nav class="breadcrumb" aria-label={zhUI ? '面包屑导航' : 'Breadcrumb'}>
        <a href={pathFor(lang)}>{brandName(lang)}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{e.about}</span>
      </nav>
      <div class="about-stage" data-enter>
        <span class="hud-corner" aria-hidden="true"></span>
        <span class="hud-corner" aria-hidden="true"></span>
        <span class="hud-corner" aria-hidden="true"></span>
        <span class="hud-corner" aria-hidden="true"></span>
        <span class="about-tag mono" aria-hidden="true">EASY AI</span>
        <span class="about-tag about-tag-end mono" aria-hidden="true">ENTERPRISE AI · MODELS · INFRASTRUCTURE</span>
        <h1 class="about-lockup">
          <span class="sr-only">{zhUI ? '关于' : 'About '}</span>
          <span class="about-whale" style={whale} aria-hidden="true"></span>
          <span class="about-wordmark">{brandName(lang)}</span>
        </h1>
      </div>
      <p class="about-slogan" data-enter style="--d:2">
        {slogan.map((part) => (part === '易' || part === 'easy' ? <em>{part}</em> : part))}
      </p>
      {
        zhUI && (
          <p class="about-slogan-en mono" data-enter style="--d:3" lang="en">
            UNDERSTAND AI · USE IT · PUT IT TO WORK
          </p>
        )
      }
      <p class="about-intro" data-enter style="--d:3">{e.aboutIntro}</p>
      <ul class="about-chips" data-enter style="--d:4">
        {
          services.map((service) => (
            <li>
              <a href={pathFor(lang, service)}>
                <ServiceIcon service={service} size={15} tile />
                {t.services[service].label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="capabilities" class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="section-title">{e.servicesTitle}</h2>
      </div>
      <div class="hub" data-reveal>
        <div class="capability-grid">
          {
            services.map((service, i) => (
              <a class="capability-card" href={pathFor(lang, service)} data-service={service} style={`--d:${i}`}>
                <span class="hub-node" aria-hidden="true">
                  <ServiceIcon service={service} size={24} />
                </span>
                <span class="capability-meta">
                  <span class="service-card-layer">{h.layers[service].name}</span>
                </span>
                <h3>{t.services[service].label}</h3>
                <p>{t.services[service].summary}</p>
                <span class="guide-link">
                  {t.explore}
                  <ArrowUpRight size={17} />
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="relationship" class="section section-tint">
    <div class="container">
      <div class="section-head section-head-split" data-reveal>
        <h2 class="section-title">{e.relationshipTitle}</h2>
        <a class="text-link" href={pathFor(lang, 'model-services')}>{t.nav.models}<ArrowRight size={16} /></a>
      </div>
      <div class="brand-pair">
        <article class="brand-card" data-reveal>
          <div class="brand-stage" aria-hidden="true">
            <span class="brand-ring"></span>
            <span class="brand-stage-tag mono">BRAND</span>
            <span class="brand-stage-tag brand-stage-tag-end mono">EASY AI</span>
            <span class="brand-lockup">
              <span class="about-whale" style={whale}></span>
              <span class="brand-lockup-name">{brandName(lang)}</span>
            </span>
          </div>
          <div class="brand-body">
            <span class="brand-kind">{zhUI ? '业务品牌' : 'Business brand'}</span>
            <h3>{brandName('zh')} / {brandName('en')}</h3>
            <p>
              {
                zhUI
                  ? '业务与合作品牌：WorkBuddy 代理、模型服务和自建机房。'
                  : 'The business and cooperation brand: WorkBuddy resale, model services and the data center.'
              }
            </p>
            <a class="guide-link" href="#capabilities">
              {e.servicesTitle}
              <ArrowRight size={16} />
            </a>
          </div>
        </article>
        <article class="brand-card" data-reveal style="--d:1">
          <div class="brand-stage" aria-hidden="true">
            <span class="brand-ring"></span>
            <span class="brand-stage-tag mono">PRODUCT</span>
            <span class="brand-stage-tag brand-stage-tag-end mono">MODEL API</span>
            <span class="brand-lockup">
              <img src={withBase('/partners/ccg-api.svg')} alt="" width="64" height="64" />
              <span class="brand-lockup-name mono">{modelProduct.name}</span>
            </span>
          </div>
          <div class="brand-body">
            <span class="brand-kind">{zhUI ? '模型服务产品' : 'Model services product'}</span>
            <h3><span class="mono">{modelProduct.name}</span></h3>
            <p>
              {
                zhUI
                  ? '模型服务中的产品入口，有独立网站；不代表全部业务，也不是本站的账号或计费系统。'
                  : 'A product entry within model services, with its own website. Not the whole business, and not this site’s account or billing system.'
              }
            </p>
            <a class="guide-link" href={modelProduct.url} target="_blank" rel="noopener noreferrer">
              {zhUI ? `打开 ${modelProduct.name}` : `Open ${modelProduct.name}`}
              <ArrowUpRight size={16} />
              <span class="sr-only">{zhUI ? '（新窗口）' : '(new window)'}</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>
</YiAiLayout>
