---
import { render } from 'astro:content';
import { ArrowUpRight, ArrowRight, ChevronDown } from '@lucide/astro';
import YiAiLayout from '../../../layouts/YiAiLayout.astro';
import GuideList from '../../../components/yi-ai/GuideList.astro';
import { getGuides } from '../../../data/routes';
import { editorial } from '../../../data/editorial';
import { articlePath, brandName, inquiryPath, pathFor, shareImage } from '../../../data/yi-ai';
import { zh } from '../../../data/zh';
import { en } from '../../../data/en';
export async function getStaticPaths() {
  return (await getGuides()).map((guide) => ({
    params: { lang: guide.data.lang, article: guide.data.pairKey },
    props: { guide },
  }));
}
const { guide } = Astro.props;
const { data } = guide;
const lang = data.lang;
const e = editorial[lang];
const t = lang === 'zh' ? zh : en;
const { Content, headings } = await render(guide);
const toc = headings.filter((heading) => heading.depth === 2);
const counterpart = (await getGuides(lang === 'zh' ? 'en' : 'zh')).find((item) => item.data.pairKey === data.pairKey)!;
const counterpartTOC = (await render(counterpart)).headings.filter((heading) => heading.depth === 2);
if (toc.length !== counterpartTOC.length) throw new Error(`Unpaired article sections: ${data.pairKey}`);
const fragmentPairs = Object.fromEntries(toc.map((heading, i) => [heading.slug, counterpartTOC[i].slug]));
const otherGuides = (await getGuides(lang)).filter((item) => item.data.pairKey !== data.pairKey);
const related = [
  ...otherGuides.filter((item) => item.data.service === data.service),
  ...otherGuides.filter((item) => item.data.service !== data.service && item.data.order % 2 === 1),
].slice(0, 3);
const minutes = Math.max(
  2,
  Math.round(
    lang === 'zh' ? guide.body!.replace(/\s/g, '').length / 450 : guide.body!.split(/\s+/).filter(Boolean).length / 220
  )
);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  dateModified: data.updatedAt,
  author: { '@type': 'Organization', name: brandName(lang) },
  citation: data.sources.map((source) => source.url),
  ...(Astro.site && {
    mainEntityOfPage: new URL(articlePath(lang, data.pairKey), Astro.site).href,
    image: new URL(shareImage(lang, 'resources', data.pairKey), Astro.site).href,
  }),
};
---

<YiAiLayout
  lang={lang}
  slug="resources"
  article={data.pairKey}
  service={data.service}
  title={data.title}
  description={data.description}
  structuredData={schema}
>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
  <section class="page-hero article-hero" data-service={data.service}>
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="container article-hero-inner">
      <nav class="breadcrumb" aria-label={lang === 'zh' ? '面包屑导航' : 'Breadcrumb'}>
        <a href={pathFor(lang)}>{brandName(lang)}</a><span aria-hidden="true">/</span><a
          href={pathFor(lang, 'resources')}>{e.resources}</a
        >
      </nav>
      <p class="eyebrow" data-enter>
        {t.services[data.service].label}
      </p>
      <h1 class="page-title article-title" data-enter style="--d:1">{data.title}</h1>
      <p class="page-intro article-description" data-enter style="--d:2">{data.description}</p>
      <p class="article-meta" data-enter style="--d:3">
        <span>{brandName(lang)}</span>
        <span aria-hidden="true">·</span>
        <span>{lang === 'zh' ? `约 ${minutes} 分钟阅读` : `${minutes} min read`}</span>
      </p>
    </div>
  </section>
  <div class="container article-layout" data-language-fragments={JSON.stringify(fragmentPairs)}>
    <aside class="article-sidebar">
      <nav class="desktop-toc" data-section-nav aria-label={e.contents}>
        <p class="micro-label">{e.contents}</p>
        <ol>
          {
            toc.map((item) => (
              <li>
                <a href={`#${item.slug}`}>{item.text}</a>
              </li>
            ))
          }
        </ol>
        <a class="btn btn-primary btn-sm toc-cta" href={inquiryPath(lang, data.service)}
          >{t.primary}<ArrowUpRight size={16} /></a
        >
      </nav>
      <details class="mobile-toc">
        <summary>{e.contents}<ChevronDown size={18} /></summary>
        <nav data-section-nav aria-label={e.contents}>
          <ol>
            {
              toc.map((item) => (
                <li>
                  <a href={`#${item.slug}`}>{item.text}</a>
                </li>
              ))
            }
          </ol>
        </nav>
      </details>
    </aside>
    <article class="article-body prose">
      {
        data.keyPoints && (
          <aside class="key-points" aria-label={lang === 'zh' ? '要点' : 'Key points'}>
            <p class="key-points-label">{lang === 'zh' ? '要点' : 'Key points'}</p>
            <ul>
              {data.keyPoints.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </aside>
        )
      }
      <Content />
      <section class="article-sources" aria-labelledby="sources">
        <h2 id="sources">{e.sources}</h2>
        <ol>
          {
            data.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {source.label}
                  <ArrowUpRight size={14} />
                  <span class="sr-only">{lang === 'zh' ? '（新窗口）' : '(new window)'}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <p>{e.sourceNote}</p>
      </section>
      <div class="article-inquiry">
        <p class="micro-label">{e.relatedService}</p>
        <h2>{t.services[data.service].label}</h2>
        <p>{t.services[data.service].intro}</p>
        <div>
          <a class="btn btn-light" href={inquiryPath(lang, data.service)}>{t.primary}<ArrowUpRight size={18} /></a>
          <a class="btn btn-ghost-light" href={pathFor(lang, data.service)}>{t.explore}<ArrowRight size={18} /></a>
        </div>
      </div>
    </article>
  </div>
  <section class="section section-tint">
    <div class="container">
      <div class="section-head section-head-split">
        <h2 class="section-title">{e.related}</h2>
        <a class="text-link" href={pathFor(lang, 'resources')}>{e.allGuides}<ArrowRight size={16} /></a>
      </div>
      <GuideList lang={lang} guides={related} />
    </div>
  </section>
</YiAiLayout>
