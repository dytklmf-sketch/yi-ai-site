---
import { ArrowRight } from '@lucide/astro';
import YiAiLayout from '../../../layouts/YiAiLayout.astro';
import GuideCards from '../../../components/yi-ai/GuideCards.astro';
import CallToAction from '../../../components/yi-ai/CallToAction.astro';
import PageHero from '../../../components/yi-ai/PageHero.astro';
import { editorial } from '../../../data/editorial';
import { refinement } from '../../../data/refinement';
import { pathFor, services, type Lang } from '../../../data/yi-ai';
import { languages, getGuides } from '../../../data/routes';
import { zh } from '../../../data/zh';
import { en } from '../../../data/en';
import ServiceIcon from '../../../components/yi-ai/ServiceIcon.astro';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const e = editorial[lang];
const t = lang === 'zh' ? zh : en;
const guides = await getGuides(lang);
---

<YiAiLayout lang={lang} slug="resources" title={e.resources} description={e.guidesIntro} chapters>
  <PageHero lang={lang} crumb={e.resources} title={e.resources} intro={e.guidesIntro} compact>
    <nav slot="meta" class="topic-tabs" data-section-nav aria-label={lang === 'zh' ? '指南分类' : 'Guide categories'}>
      {
        services.map((service) => (
          <a href={`#${service}`}>
            <ServiceIcon service={service} size={16} />
            {t.services[service].label}
          </a>
        ))
      }
    </nav>
  </PageHero>
  {
    services.map((service, i) => (
      <section id={service} class:list={['section', 'resource-section', { 'section-tint': i % 2 === 1 }]}>
        <div class="container">
          <div class="section-head section-head-split" data-reveal>
            <div>
              <p class="eyebrow">{refinement[lang].audiences[service]}</p>
              <h2 class="section-title">{t.services[service].label}</h2>
            </div>
            <a class="text-link" href={pathFor(lang, service)}>
              {t.explore}
              <ArrowRight size={16} />
            </a>
          </div>
          <GuideCards lang={lang} guides={guides.filter(({ data }) => data.service === service)} />
        </div>
      </section>
    ))
  }
  <CallToAction lang={lang} />
</YiAiLayout>
