---
import YiAiLayout from '../../../layouts/YiAiLayout.astro';
import WidgetWrapper from '../../../components/ui/WidgetWrapper.astro';
import GuideCards from '../../../components/yi-ai/GuideCards.astro';
import CallToAction from '../../../components/yi-ai/CallToAction.astro';
import { editorial } from '../../../data/editorial';
import { refinement } from '../../../data/refinement';
import { brandName, pathFor, services, type Lang } from '../../../data/yi-ai';
import { languages, getGuides } from '../../../data/routes';
import { zh } from '../../../data/zh';
import { en } from '../../../data/en';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const e = editorial[lang];
const t = lang === 'zh' ? zh : en;
const guides = await getGuides(lang);
---

<YiAiLayout lang={lang} slug="resources" title={e.resources} description={e.guidesIntro}>
  <section class="page-hero">
    <div class="site-container">
      <nav class="breadcrumb" aria-label={lang === 'zh' ? '面包屑导航' : 'Breadcrumb'}>
        <a href={pathFor(lang)}>{brandName(lang)}</a><span>/</span><span>{e.resources}</span>
      </nav>
      <div class="page-hero-grid">
        <div><p class="eyebrow">{e.resources}</p><h1>{e.guidesTitle}</h1></div><div class="page-hero-copy">
          <p>{e.guidesIntro}</p>
        </div>
      </div>
    </div>
  </section>
  <nav
    class="guide-topics site-container"
    data-section-nav
    aria-label={lang === 'zh' ? '指南分类' : 'Guide categories'}
  >
    {services.map((service) => <a href={`#${service}`}>{t.services[service].label}</a>)}
  </nav>
  {
    services.map((service) => (
      <WidgetWrapper id={service} class="resource-section">
        <>
          <div class="section-head">
            <div>
              <>
                <p class="eyebrow">{refinement[lang].audiences[service]}</p>
                <h2>{t.services[service].label}</h2>
              </>
            </div>
            <a class="text-link" href={pathFor(lang, service)}>
              {t.explore}
            </a>
          </div>
          <GuideCards lang={lang} guides={guides.filter(({ data }) => data.service === service)} />
        </>
      </WidgetWrapper>
    ))
  }
  <CallToAction lang={lang} />
</YiAiLayout>
