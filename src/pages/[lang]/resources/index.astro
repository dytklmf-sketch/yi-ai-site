---
import { ArrowRight } from '@lucide/astro';
import YiAiLayout from '../../../layouts/YiAiLayout.astro';
import GuideCards from '../../../components/yi-ai/GuideCards.astro';
import PageHero from '../../../components/yi-ai/PageHero.astro';
import { editorial } from '../../../data/editorial';
import { home } from '../../../data/home';
import { pathFor, services, type Lang } from '../../../data/yi-ai';
import { languages, getGuides } from '../../../data/routes';
import { zh } from '../../../data/zh';
import { en } from '../../../data/en';
import ServiceIcon from '../../../components/yi-ai/ServiceIcon.astro';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const e = editorial[lang];
const t = lang === 'zh' ? zh : en;
const guides = await getGuides(lang);
// One grid in service order, so the filter can narrow it without reordering cards.
const sorted = services.flatMap((service) => guides.filter(({ data }) => data.service === service));
---

<YiAiLayout lang={lang} slug="resources" title={e.resources} description={e.guidesIntro} chapters>
  <PageHero lang={lang} crumb={e.resources} title={e.resources} intro={e.guidesIntro} compact />
  <section class="section resource-section" id="guides" aria-label={e.resources}>
    <div class="container">
      <div
        class="faq-filter guide-filter"
        data-filter-group
        hidden
        role="group"
        aria-label={lang === 'zh' ? '按业务筛选' : 'Filter by service'}
      >
        <button type="button" aria-pressed="true" data-filter="all">{home[lang].faqAll}</button>
        {
          services.map((service) => (
            <button type="button" aria-pressed="false" data-filter={service}>
              <ServiceIcon service={service} size={16} />
              {t.services[service].label}
            </button>
          ))
        }
      </div>
      <GuideCards lang={lang} guides={sorted} />
      <nav class="other-services" aria-label={lang === 'zh' ? '相关业务' : 'Related services'}>
        <p>{lang === 'zh' ? '按业务了解服务' : 'Explore by service'}</p>
        {
          services.map((service) => (
            <a href={pathFor(lang, service)}>
              <ServiceIcon service={service} size={16} />
              {t.services[service].label}
              <ArrowRight size={16} />
            </a>
          ))
        }
      </nav>
    </div>
  </section>
</YiAiLayout>
