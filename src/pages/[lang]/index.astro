---
import { ArrowDown, ArrowUpRight, ArrowRight, BadgeCheck } from '@lucide/astro';
import YiAiLayout from '../../layouts/YiAiLayout.astro';
import StackVisual from '../../components/yi-ai/StackVisual.astro';
import ServiceColumns from '../../components/yi-ai/ServiceColumns.astro';
import GuideCards from '../../components/yi-ai/GuideCards.astro';
import FaqChapter from '../../components/yi-ai/FaqChapter.astro';
import CallToAction from '../../components/yi-ai/CallToAction.astro';
import WhyChapter from '../../components/yi-ai/WhyChapter.astro';
import { getGuides } from '../../data/routes';
import { editorial } from '../../data/editorial';
import { featuredGuides } from '../../data/refinement';
import { home } from '../../data/home';
import { inquiryPath, pathFor, workbuddyCredential, type Lang } from '../../data/yi-ai';
import { zh } from '../../data/zh';
import { en } from '../../data/en';

export function getStaticPaths() {
  return ['zh', 'en'].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = lang === 'zh' ? zh : en;
const h = home[lang];
const e = editorial[lang];
const guides = (await getGuides(lang)).filter(({ data }) => featuredGuides[data.service] === data.pairKey);
---

<YiAiLayout
  lang={lang}
  darkHero
  chapters
  title={lang === 'zh' ? '企业 AI 应用与算力供应服务商' : 'Your enterprise AI applications and compute provider'}
  description={t.heroIntro}
>
  <section class="hero" id="intro" aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true">
      <span class="hero-grid-lines"></span><span class="hero-glow"></span>
      <span class="hud-rings"></span>
      <span class="hud-floor"></span>
    </div>
    <div class="container hero-layout">
      <div class="hero-copy">
        <p class="eyebrow eyebrow-light" data-enter>{h.heroEyebrow}</p>
        <h1 class="hero-title" id="hero-title" data-enter style="--d:1">
          <span>{h.heroTitle[0]}</span>
          <span class="hero-title-accent">{h.heroTitle[1]}</span>
        </h1>
        <p class="hero-lead" data-enter style="--d:2">{t.heroIntro}</p>
        <div class="hero-actions" data-enter style="--d:3">
          <a class="btn btn-primary btn-lg" href={inquiryPath(lang)}>{t.primary}<ArrowUpRight size={18} /></a>
          <a class="btn btn-ghost-light btn-lg" href="#services">{t.secondary}<ArrowDown size={18} /></a>
        </div>
        <a class="hero-credential" href={`${pathFor(lang, 'workbuddy')}#process`} data-enter style="--d:4">
          <BadgeCheck size={16} />
          {workbuddyCredential.partner[lang]}
          <ArrowRight size={14} />
        </a>
      </div>
      <figure class="hero-visual">
        <span class="hud-corner" aria-hidden="true"></span>
        <span class="hud-corner" aria-hidden="true"></span>
        <span class="hud-corner" aria-hidden="true"></span>
        <span class="hud-corner" aria-hidden="true"></span>
        <span class="hud-tag mono" aria-hidden="true">ENTERPRISE AI · MODELS · INFRASTRUCTURE</span>
        <StackVisual lang={lang} id="hero" class="stack-wide" />
        <StackVisual lang={lang} id="hero-narrow" labels={false} class="stack-narrow" />
        <figcaption class="mono">{h.stackCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section layers" id="services" aria-labelledby="layers-title">
    <div class="container">
      <div class="section-head section-head-split" data-reveal>
        <h2 id="layers-title" class="section-title">{h.stackTitle}</h2>
        <a class="text-link" href={`${pathFor(lang, 'about')}#relationship`}
          >{lang === 'zh' ? '品牌与产品关系' : 'Brand and product roles'}<ArrowRight size={16} /></a
        >
      </div>
      <ServiceColumns lang={lang} />
    </div>
  </section>

  <WhyChapter lang={lang} />

  <section class="section guides-band" id="guides" aria-labelledby="guides-title">
    <div class="container">
      <div class="section-head section-head-split" data-reveal>
        <h2 id="guides-title" class="section-title">{e.resources}</h2>
        <a class="text-link" href={pathFor(lang, 'resources')}>{e.allGuides}<ArrowRight size={16} /></a>
      </div>
      <GuideCards lang={lang} guides={guides} featured />
    </div>
  </section>

  <FaqChapter lang={lang} />
  <CallToAction lang={lang} inline />
</YiAiLayout>
