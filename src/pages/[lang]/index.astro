---
import { ArrowDown, ArrowUpRight } from '@lucide/astro';
import YiAiLayout from '../../layouts/YiAiLayout.astro';
import CallToAction from '../../components/yi-ai/CallToAction.astro';
import GuideCards from '../../components/yi-ai/GuideCards.astro';
import ServicesChapter from '../../components/yi-ai/ServicesChapter.astro';
import CapabilitiesChapter from '../../components/yi-ai/CapabilitiesChapter.astro';
import ProcessChapter from '../../components/yi-ai/ProcessChapter.astro';
import FaqChapter from '../../components/yi-ai/FaqChapter.astro';
import WidgetWrapper from '../../components/ui/WidgetWrapper.astro';
import { getGuides } from '../../data/routes';
import { editorial } from '../../data/editorial';
import { refinement, featuredGuides } from '../../data/refinement';
import { brandName, services, inquiryPath, pathFor, type Lang } from '../../data/yi-ai';
import { zh } from '../../data/zh';
import { en } from '../../data/en';
import '../../styles/home-chapters.css';
import '../../styles/hero-dark.css';
import '../../styles/chapter-themes.css';

export function getStaticPaths() {
  return ['zh', 'en'].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = lang === 'zh' ? zh : en;
const guides = (await getGuides(lang)).filter(({ data }) => featuredGuides[data.service] === data.pairKey);
const e = editorial[lang];
const r = refinement[lang];
const serviceLabels = {
  workbuddy: t.nav.workbuddy,
  'model-services': t.nav.models,
  infrastructure: t.nav.infrastructure,
};
const chapters = [
  { id: 'intro', label: t.nav.home },
  { id: 'services', label: lang === 'zh' ? '我们的服务' : 'Our services' },
  { id: 'capabilities', label: lang === 'zh' ? '业务能力' : 'Our capabilities' },
  { id: 'process', label: lang === 'zh' ? '合作流程' : 'Working together' },
  { id: 'guides', label: e.resources },
  { id: 'faq', label: lang === 'zh' ? '常见问题' : 'Common questions' },
  { id: 'inquiry', label: t.primary },
];
---

<YiAiLayout
  lang={lang}
  homeChapters
  title={lang === 'zh' ? '让 AI 易懂、易用、易落地' : 'Understand AI. Use it. Put it to work.'}
  description={t.heroIntro}
>
  <nav class="chapter-nav" aria-label={lang === 'zh' ? '首页目录' : 'Homepage sections'}>
    {
      chapters.map(({ id, label }, index) => (
        <a href={`#${id}`} aria-label={label}>
          <span class="chapter-dot" aria-hidden="true" />
          <span class="chapter-label" aria-hidden="true">
            <span>{String(index + 1).padStart(2, '0')}</span>
            {label}
          </span>
        </a>
      ))
    }
  </nav>

  <section id="intro" class="hero-band hero-dark home-chapter">
    <div class="site-container hero-inner">
      <!-- Inline SVG for whale-draw.ts stroke animation -->
      <svg
        id="hero-whale-draw"
        class="hero-whale-svg"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 304 192"
        aria-hidden="true"
      >
        <g transform="translate(2 6)">
          <path data-draw data-fill="var(--dark-accent, #3D6FF0)" fill-rule="evenodd" d="M23 80V76C23 48 46 28 78 28H129C133 28 134 29 132 32L121 48C113 59 106 63 95 63H75C54 63 37 69 25 82C24 83 23 83 23 80Z M51.5 48a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0Z" />
          <path data-draw data-fill="var(--dark-accent, #3D6FF0)" d="M48 88H95C108 88 117 83 125 72L148 41C155 31 161 27 169 28C179 29 185 35 191 46L220 105C224 114 226 123 226 133V148Q226 152 222 152H216Q213 152 211 148L174 82C171 76 166 75 162 81L143 109C135 121 127 125 114 125H45C47 137 55 144 70 144H93C104 144 112 139 121 132C129 125 136 122 144 122C156 122 164 128 170 137L181 154Q185 160 178 160H72C41 160 19 139 19 110V108C19 95 30 88 48 88Z" />
          <path data-draw data-fill="var(--dark-accent, #3D6FF0)" d="M232 85C234 75 238 66 244 60C229 57 219 46 216 32C215 28 217 27 221 28C233 31 243 37 250 46Q252 49 254 46C260 36 269 30 280 29Q284 29 282 33C279 49 270 60 259 65C259 74 256 82 253 90Z" />
          <path data-draw data-fill="var(--dark-accent, #3D6FF0)" d="M254 101C252 122 247 140 237 149C235 151 233 152 232 152V127C232 115 239 106 250 101C252 100 254 99 254 101Z" />
        </g>
      </svg>
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="status-dot"></span>
          {lang === 'zh' ? '为真实业务而来的 AI 服务' : 'AI SERVICES FOR REAL WORK'}
        </p>
        <h1 class="hero-brand">
          {brandName(lang)}<span class="hero-alias">{brandName(lang === 'zh' ? 'en' : 'zh')}</span>
        </h1>
        <p class="hero-promise">{t.heroHeadline[0]}<br /><span>{t.heroHeadline[1]}</span></p>
        <p class="hero-intro">{t.heroIntro}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={inquiryPath(lang)}>{t.primary}<ArrowUpRight size={18} /></a>
          <a class="text-link" href="#services">{t.secondary}<ArrowDown size={17} /></a>
        </div>
        <ul class="hero-audiences" aria-label={lang === 'zh' ? '服务对象' : 'Who we work with'}>
          {services.map((service) => <li>{r.audiences[service]}</li>)}
        </ul>
      </div>
      <aside class="hero-side-panel" aria-label={lang === 'zh' ? '易AI 合作路径' : 'Easy AI cooperation routes'}>
        <p class="eyebrow">{lang === 'zh' ? '从业务目标开始' : 'START WITH THE WORK'}</p>
        <ol class="hero-route-list">
          {
            services.map((slug, i) => (
              <li>
                <a href={pathFor(lang, slug)}>
                  <span class="hero-route-number">0{i + 1}</span>
                  <span class="hero-route-copy">
                    <strong>{t.scenarios[i].title}</strong>
                    <small>{t.services[slug].short}</small>
                  </span>
                  <ArrowUpRight size={17} />
                </a>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
    <a class="chapter-next" href="#services">
      <span>01 / {chapters[1].label}</span><ArrowDown size={18} />
    </a>
  </section>

  <ServicesChapter lang={lang} t={t} />
  <CapabilitiesChapter lang={lang} t={t} />
  <ProcessChapter lang={lang} t={t} />
  <ProcessChapter lang={lang} t={t} />

  <WidgetWrapper id="guides" class="guides-band" chapter>
    <div class="section-head">
      <div><p class="eyebrow">04 / {e.resources}</p><h2>{e.featuredTitle}</h2></div>
      <a class="text-link" href={pathFor(lang, 'resources')}>{e.allGuides}</a>
    </div>
    <GuideCards lang={lang} guides={guides} featured />
  </WidgetWrapper>

  <FaqChapter lang={lang} t={t} serviceLabels={serviceLabels} />
  <CallToAction lang={lang} chapter />
  <script src="../../scripts/chapter-navigation.ts"></script>
  <script src="../../scripts/whale-draw.ts"></script>
</YiAiLayout>
