---
import { ArrowUpRight, ArrowRight, Check, CircleAlert, CircleDashed, Download } from '@lucide/astro';
import ServiceIcon from '../../components/yi-ai/ServiceIcon.astro';
import { scenarioIcons } from '../../components/yi-ai/icons';
import YiAiLayout from '../../layouts/YiAiLayout.astro';
import CallToAction from '../../components/yi-ai/CallToAction.astro';
import ContactPanel from '../../components/yi-ai/ContactPanel.astro';
import GuideCards from '../../components/yi-ai/GuideCards.astro';
import ServiceSample from '../../components/yi-ai/ServiceSample.astro';
import PageHero from '../../components/yi-ai/PageHero.astro';
import WorkBuddyEditions from '../../components/yi-ai/WorkBuddyEditions.astro';
import { getGuides } from '../../data/routes';
import { editorial } from '../../data/editorial';
import { serviceDetails } from '../../data/service-details';
import { refinement } from '../../data/refinement';
import { serviceBriefs, workbuddyEditions } from '../../data/workbuddy-editions';
import { home } from '../../data/home';
import {
  pageSlugs,
  services,
  inquiryPath,
  pathFor,
  modelProduct,
  brandName,
  withBase,
  workbuddyCredential,
  type Lang,
  type PageSlug,
} from '../../data/yi-ai';
import { zh } from '../../data/zh';
import { en } from '../../data/en';
export function getStaticPaths() {
  return ['zh', 'en'].flatMap((lang) => pageSlugs.map((slug) => ({ params: { lang, slug } })));
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as PageSlug;
const t = lang === 'zh' ? zh : en;
const isContact = slug === 'contact';
const page = !isContact ? t.services[slug] : null;
const title = page?.title || t.contact.title;
const intro = page?.intro || t.contact.intro;
const service = slug === 'contact' ? undefined : slug;
const detail = service ? serviceDetails[lang][service] : null;
const e = editorial[lang];
const r = refinement[lang];
const h = home[lang];
const guides = service ? (await getGuides(lang)).filter(({ data }) => data.service === service) : [];
const zhUI = lang === 'zh';
const { certificate } = workbuddyCredential;
// Page order: (WorkBuddy only) Enterprise pricing first, then use cases, process, guides.
const chapters: [string, string][] = [
  ...(service === 'workbuddy' ? [['editions', workbuddyEditions[lang].label] as [string, string]] : []),
  ['fit', r.serviceContents.fit],
  ['process', r.serviceContents.process],
  ['guides', r.serviceContents.guides],
];
const briefFile = service ? serviceBriefs[lang][service] : undefined;
const credentials = {
  partner: workbuddyCredential.partner[lang],
  note: zhUI
    ? '易AI 通过该授权渠道开展 WorkBuddy 采购咨询，产品功能与版本权益以官方说明为准。'
    : 'Easy AI handles WorkBuddy procurement through this authorized channel. Product features and licence terms follow the official documentation.',
};
---

<YiAiLayout
  lang={lang}
  slug={slug}
  service={service}
  title={page?.seoTitle || t.contact.seoTitle}
  description={intro}
  chapters={Boolean(page && service)}
>
  {
    page && service ? (
      <>
        <PageHero
          lang={lang}
          crumb={page.label}
          eyebrow={`${h.layers[service].name} · ${page.short}`}
          mark={service === 'workbuddy' ? '/partners/workbuddy.svg' : undefined}
          title={title}
          intro={intro}
        >
          <div slot="actions" class="hero-actions">
            {service === 'model-services' ? (
              <>
                <a class="btn btn-primary btn-lg" href={modelProduct.url} target="_blank" rel="noopener noreferrer">
                  {zhUI ? `打开 ${modelProduct.name}` : `Open ${modelProduct.name}`}
                  <ArrowUpRight size={18} />
                  <span class="sr-only">{zhUI ? '（新窗口）' : '(new window)'}</span>
                </a>
                <a class="btn btn-outline btn-lg" href={inquiryPath(lang, service)}>
                  {zhUI ? '企业用量咨询' : 'Enterprise usage'}
                  <ArrowRight size={18} />
                </a>
              </>
            ) : (
              <>
                <a class="btn btn-primary btn-lg" href={inquiryPath(lang, service)}>
                  {t.primary}
                  <ArrowUpRight size={18} />
                </a>
                <a class="btn btn-outline btn-lg" href="#process">
                  {e.process}
                  <ArrowRight size={18} />
                </a>
              </>
            )}
          </div>
          <p slot="meta" class="audience-strip">
            <span class="micro-label">{zhUI ? '适合' : 'For'}</span>
            {page.audience}
          </p>
          <div slot="visual" class="page-hero-visual page-hero-sample">
            <ServiceSample lang={lang} service={service} />
          </div>
        </PageHero>

        <nav class="subnav" data-section-nav aria-label={zhUI ? '本页目录' : 'On this page'}>
          <div class="container subnav-row">
            {chapters.map(([id, label], i) => (
              <a href={`#${id}`}>
                <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                {label}
              </a>
            ))}
          </div>
        </nav>

        {service === 'workbuddy' && <WorkBuddyEditions lang={lang} />}

        {detail && (
          <section id="fit" class="section">
            <div class="container split split-even split-fit">
              <div class="fit-copy">
                <h2 class="section-title" data-reveal>
                  {r.serviceContents.fit}
                </h2>
                <ul class="scenario-grid" data-reveal>
                  {page.scenarios.map((item, i) => {
                    const Icon = scenarioIcons[service][i];
                    return (
                      <li>
                        <span class="scenario-icon">
                          <Icon size={20} />
                        </span>
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                      </li>
                    );
                  })}
                </ul>
              </div>
              <div class="scope-panel" data-reveal>
                <h3 class="scope-panel-title">{e.scope}</h3>
                <div class="scope-grid">
                  <div class="scope-col scope-yes">
                    <h4>{e.included}</h4>
                    <ul>
                      {detail.discuss.map((item) => (
                        <li>
                          <Check size={16} />
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="scope-col scope-confirm">
                    <h4>{e.excluded}</h4>
                    <ul>
                      {detail.confirm.map((item) => (
                        <li>
                          <CircleDashed size={16} />
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
                <p class="boundary-note">
                  <CircleAlert size={18} />
                  <span>{page.boundary}</span>
                </p>
              </div>
            </div>
          </section>
        )}

        {detail && (
          <section id="process" class="section section-tint">
            <div class="container">
              <h2 class="section-title" data-reveal>
                {r.serviceContents.process}
              </h2>
              <ol class="step-cards">
                {detail.steps.map((step, i) => (
                  <li data-reveal style={`--d:${i}`}>
                    <span class="step-card-index mono">{String(i + 1).padStart(2, '0')}</span>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </li>
                ))}
              </ol>
              <div class="brief-card" data-reveal>
                <div class="brief-main">
                  <h3 class="brief-title">{e.pricing}</h3>
                  <ul class="tag-list">
                    {detail.brief.map((item) => (
                      <li>
                        <Check size={14} />
                        {item}
                      </li>
                    ))}
                  </ul>
                  {detail.briefExample && (
                    <p class="brief-example">
                      <span class="micro-label">{zhUI ? '例如' : 'For example'}</span>
                      {detail.briefExample}
                    </p>
                  )}
                </div>
                <div class="brief-actions">
                  <a class="btn btn-light" href={inquiryPath(lang, service)}>
                    {t.primary}
                    <ArrowRight size={17} />
                  </a>
                  {briefFile && (
                    <a class="brief-download" href={withBase(`/templates/${lang}/${briefFile.file}`)} download>
                      <Download size={15} />
                      {zhUI ? `下载${briefFile.label}` : `Download the ${briefFile.label.toLowerCase()}`}
                    </a>
                  )}
                </div>
              </div>

              {service === 'workbuddy' && (
                <div class="credential-block" data-reveal>
                  <a class="credential-thumb" href={withBase(certificate)} target="_blank" rel="noopener noreferrer">
                    <img
                      src={withBase(certificate)}
                      alt={
                        zhUI
                          ? '腾讯云 WorkBuddy / CodeBuddy 官方授权合作伙伴证书'
                          : 'Tencent Cloud WorkBuddy / CodeBuddy authorized-partner certificate'
                      }
                      width="1200"
                      height="848"
                      decoding="async"
                    />
                  </a>
                  <div class="credential-body">
                    <div class="credential-head">
                      <span class="micro-label">{zhUI ? '合作资质' : 'Credentials'}</span>
                      <p class="credential-lockup" aria-hidden="true">
                        <span class="credential-lockup-part">
                          <img src={withBase('/brand/logo-symbol.svg')} alt="" width="22" height="22" />
                          <span class="mono">{brandName(lang)}</span>
                        </span>
                        <span class="credential-lockup-x">×</span>
                        <span class="credential-lockup-part">
                          <img src={withBase('/partners/workbuddy.svg')} alt="" width="22" height="22" />
                          <span class="mono">WorkBuddy</span>
                        </span>
                      </p>
                    </div>
                    <p class="credential-title">{credentials.partner}</p>
                    <p class="credential-note">{credentials.note}</p>
                    <a class="text-link" href={withBase(certificate)} target="_blank" rel="noopener noreferrer">
                      {zhUI ? '查看证书' : 'View the certificate'}
                      <ArrowUpRight size={16} />
                      <span class="sr-only">{zhUI ? '（新窗口）' : '(new window)'}</span>
                    </a>
                  </div>
                </div>
              )}
            </div>
          </section>
        )}

        <section id="guides" class="section">
          <div class="container">
            <div class="section-head section-head-split" data-reveal>
              <h2 class="section-title">{r.serviceContents.guides}</h2>
              <a class="text-link" href={pathFor(lang, 'resources')}>
                {e.allGuides}
                <ArrowRight size={16} />
              </a>
            </div>
            <GuideCards lang={lang} guides={guides} />
            <nav class="other-services" aria-label={zhUI ? '其他业务' : 'Other services'}>
              <p>{zhUI ? '还有其他需求？' : 'Exploring another need?'}</p>
              {services
                .filter((item) => item !== service)
                .map((item) => (
                  <a href={pathFor(lang, item)}>
                    <ServiceIcon service={item} size={16} />
                    {t.services[item].label}
                    <ArrowRight size={16} />
                  </a>
                ))}
            </nav>
          </div>
        </section>
        <CallToAction lang={lang} service={service} />
      </>
    ) : (
      <>
        <PageHero lang={lang} crumb={t.nav.contact} title={title} intro={intro} compact />
        <section class="section contact-section">
          <div class="container contact-layout">
            <ContactPanel lang={lang} />
            <aside class="contact-aside">
              <p class="micro-label">{e.explore}</p>
              <nav class="service-links" aria-label={zhUI ? '继续了解业务' : 'Explore our services'}>
                {services.map((serviceSlug) => (
                  <a href={pathFor(lang, serviceSlug)}>
                    <ServiceIcon service={serviceSlug} size={18} tile />
                    <span>
                      <strong>{t.services[serviceSlug].label}</strong>
                      <small>{t.services[serviceSlug].short}</small>
                    </span>
                    <ArrowRight size={17} />
                  </a>
                ))}
              </nav>
              <div class="contact-steps">
                <p class="micro-label">{e.process}</p>
                <ol>
                  {t.steps.map((step, i) => (
                    <li>
                      <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                      <span>
                        <strong>{step.title}</strong>
                        {step.text}
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            </aside>
          </div>
        </section>
      </>
    )
  }
</YiAiLayout>
