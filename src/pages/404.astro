---
import YiAiLayout from '../layouts/YiAiLayout.astro';
import { ArrowLeft } from '@lucide/astro';
---

<YiAiLayout
  lang="zh"
  notFound
  title="页面未找到 / Page not found"
  description="返回易AI 首页 / Return to the Easy AI homepage."
>
  <section class="not-found site-container">
    <p class="eyebrow">404 / PAGE NOT FOUND</p>
    <h1>这条路，<br />换个方向出发。</h1>
    <p>你访问的页面不存在。<br />This page could not be found.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="/zh/"><ArrowLeft size={17} />返回首页</a><a class="text-link" href="/en/"
        >English home</a
      >
    </div>
  </section>
</YiAiLayout>
