{
  "name": "yi-ai-brand-site",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "build:production": "SITE_ORIGIN=https://ccg-cli.online SITE_BASE=/yi_ai astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node scripts/test-build.mjs",
    "test:production": "SITE_ORIGIN=https://ccg-cli.online SITE_BASE=/yi_ai node scripts/test-build.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:quick": "node scripts/quick-check.mjs",
    "package:preview": "node scripts/package-preview.mjs",
    "assets:brand": "node --experimental-strip-types scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@lucide/astro": "1.47.0",
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.9.0",
    "playwright": "1.58.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
